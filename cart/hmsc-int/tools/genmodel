#!/usr/bin/env bash
# genmodel — generate a 3D model GLB to OPEN IN THE STUDIO and paint, instead of
# baking a static prop (that's genprop). Writes into cart/hmsc-int/data/generated/
# where the Studio's "⬇ Import GLB" dialog looks, and prints the path to paste in.
#
# Lower default poly than genprop: a paintable model wants bigger UV islands, so
# the per-face pixel painter has room to stroke (a 90k-face Shap-E blob unwraps to
# thousands of micro-islands you can't paint cleanly).
#
# Usage:
#   tools/genmodel "fire hydrant"            # text -> model
#   tools/genmodel ./ref.png                 # image -> model
#   tools/genmodel "wooden barrel" --faces 1200 --seed 3
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"          # cart/hmsc-int/tools
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
GENMESH_DIR="$SCRIPT_DIR/genmesh"
VENV_PY="$GENMESH_DIR/.venv/bin/python"
OUT_DIR="$REPO_ROOT/cart/hmsc-int/data/generated"

if [[ $# -lt 1 ]]; then
  echo "usage: tools/genmodel \"<prompt>\"|<image.png> [--faces N] [--seed N] [--steps N] [--backend B]" >&2
  exit 2
fi

INPUT="$1"; shift
FACES=800
GEN_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --faces) FACES="$2"; shift 2;;
    --backend|--seed|--steps|--guidance|--up) GEN_ARGS+=("$1" "$2"); shift 2;;
    --via-image|--no-rembg) GEN_ARGS+=("$1"); shift;;
    *) echo "[genmodel] unknown option: $1" >&2; exit 2;;
  esac
done

if [[ ! -x "$VENV_PY" ]]; then
  echo "[genmodel] generation venv missing — running setup.sh (one-time)…" >&2
  bash "$GENMESH_DIR/setup.sh"
fi

slug() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }
if [[ -f "$INPUT" ]]; then GEN_INPUT=(--image "$INPUT"); BASE="$(basename "${INPUT%.*}")"; else GEN_INPUT=(--text "$INPUT"); BASE="$(slug "$INPUT")"; fi
[[ -z "$BASE" ]] && BASE="model"

mkdir -p "$OUT_DIR"
OUT="$OUT_DIR/$BASE.glb"
REL="cart/hmsc-int/data/generated/$BASE.glb"

echo "[genmodel] generating $REL …" >&2
"$VENV_PY" "$GENMESH_DIR/genmesh.py" --out "$OUT" "${GEN_INPUT[@]}" --faces "$FACES" "${GEN_ARGS[@]}"
echo "" >&2
echo "[genmodel] done. In the Studio: click '⬇ Import GLB' and use this path:" >&2
echo "    $REL" >&2
