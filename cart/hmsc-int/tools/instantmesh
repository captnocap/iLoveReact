#!/usr/bin/env bash
# instantmesh — image -> textured 3D mesh, one verb.
#
# Wraps the verbose InstantMesh invocation (conda activate + cd deps/InstantMesh +
# run.py + the large config + texmap export) into a single command:
#
#   tools/instantmesh ./photo.png
#
# That's it. Hands the image to the InstantMesh LRM (instant-mesh-large.yaml) in
# the `instantmesh` conda env and drops a textured .obj (+ .mtl + texture png) in
# the output dir. Prints the final mesh path on success.
#
# Usage:
#   tools/instantmesh <image.png|.jpg|.webp | a directory of images> [options]
#
# Options (the common ones; anything else is forwarded verbatim to run.py):
#   --out <dir>        output directory     (default: deps/InstantMesh/outputs)
#   --config <name>    config under configs/ (default: instant-mesh-large.yaml)
#   --no-rembg         skip background removal (input already has alpha/clean bg)
#   --no-texmap        export geometry only, no baked texture map
#   --seed <n>         sampling seed        (default: run.py's 42)
#   --steps <n>        diffusion steps      (default: run.py's 75)
#   --views <4|6>      input views          (default: run.py's 6)
#   --video            also render a circular-view mp4
#
# Mesh lands in: <out>/<config-name>/meshes/<image-basename>.obj
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # cart/hmsc-int/tools
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
IM_DIR="$REPO_ROOT/deps/InstantMesh"
ENV_NAME=instantmesh

if [[ $# -lt 1 ]]; then
  echo "usage: tools/instantmesh <image.png>|<dir> [options]" >&2
  echo "       see the header of $0 for options" >&2
  exit 2
fi

INPUT="$1"; shift
if [[ ! -e "$INPUT" ]]; then
  echo "[instantmesh] input not found: $INPUT" >&2
  exit 2
fi
# Resolve to an absolute path so cd-ing into deps/InstantMesh doesn't lose it.
INPUT="$(cd "$(dirname "$INPUT")" && pwd)/$(basename "$INPUT")"

# Defaults, then translate the friendly flags into run.py's flags.
OUT="$IM_DIR/outputs"
CONFIG="instant-mesh-large.yaml"
RUN_ARGS=(--export_texmap)   # texmap on by default; --no-texmap drops it
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out)       OUT="$2"; shift 2;;
    --config)    CONFIG="$2"; shift 2;;
    --no-rembg)  RUN_ARGS+=(--no_rembg); shift;;
    --no-texmap) RUN_ARGS=("${RUN_ARGS[@]/--export_texmap}"); shift;;
    --seed)      RUN_ARGS+=(--seed "$2"); shift 2;;
    --steps)     RUN_ARGS+=(--diffusion_steps "$2"); shift 2;;
    --views)     RUN_ARGS+=(--view "$2"); shift 2;;
    --video)     RUN_ARGS+=(--save_video); shift;;
    *)           RUN_ARGS+=("$1"); shift;;   # forward anything else to run.py
  esac
done
# Absolute output dir (run.py writes relative to its own cwd otherwise).
mkdir -p "$OUT"; OUT="$(cd "$OUT" && pwd)"

# Activate the conda env (independent of the broken base env; see setup-instantmesh.sh).
command -v conda >/dev/null || { echo "[instantmesh] conda not on PATH" >&2; exit 1; }
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"

CONFIG_NAME="$(basename "${CONFIG%.*}")"
echo "[instantmesh] $INPUT -> $OUT/$CONFIG_NAME/meshes/ (config: $CONFIG)" >&2
( cd "$IM_DIR" && python run.py "configs/$CONFIG" "$INPUT" --output_path "$OUT" "${RUN_ARGS[@]}" )

# Report the resulting mesh path(s).
echo "" >&2
echo "[instantmesh] done. meshes in: $OUT/$CONFIG_NAME/meshes/" >&2
ls -1 "$OUT/$CONFIG_NAME/meshes/"*.obj 2>/dev/null | sed 's/^/  /' >&2 || true
