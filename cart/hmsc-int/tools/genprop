#!/usr/bin/env bash
# genprop — text/image -> 3D mesh -> baked into the hmsc-int prop registry.
#
# One command, no separate app, no manual export/import. This is the repo-owned
# version of modly's pipeline: a local diffusion model (running on your GPU in an
# isolated venv, see tools/genmesh/setup.sh) turns a prompt or image into a GLB,
# which is handed straight to importPropMesh.mjs so the result lands in the prop
# catalog as a placeable, collidable prop.
#
# Usage:
#   tools/genprop "red fire hydrant" --kind imported.hydrant --height 0.9
#   tools/genprop ./photo.png        --kind imported.chair  --label Chair
#
# The first positional arg is the prompt OR an image path (auto-detected: if it's
# an existing file it's treated as an image, otherwise as a text prompt).
#
# Options (prop side, forwarded to importPropMesh.mjs):
#   --kind <id>        prop kind, default imported.<slug-of-prompt>
#   --label <text>     palette label
#   --height <meters>  real-world height the prop is normalized to (default 1)
#   --color <hex|r,g,b>  flat fallback color
#   --solid <bool>     blocks movement (default true)
#   --cover <hard|soft|none>
# Options (generation side, forwarded to genmesh.py):
#   --backend <name>   image->3D model (default shap-e)
#   --seed <n>         reproducibility (default 0)
#   --steps <n>        diffusion steps (default 64)
#   --keep-glb <path>  also keep the generated GLB at this path
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"          # cart/hmsc-int/tools
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
GENMESH_DIR="$SCRIPT_DIR/genmesh"
VENV_PY="$GENMESH_DIR/.venv/bin/python"

if [[ $# -lt 1 ]]; then
  echo "usage: tools/genprop \"<prompt>\"|<image.png> --kind imported.<id> [options]" >&2
  echo "       see the header of $0 for the full option list" >&2
  exit 2
fi

# First positional = prompt or image path.
INPUT="$1"; shift

# Split remaining args into generation-side and prop-side.
GEN_ARGS=()
PROP_ARGS=()
KIND=""
KEEP_GLB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend|--seed|--steps) GEN_ARGS+=("$1" "$2"); shift 2;;
    --keep-glb) KEEP_GLB="$2"; shift 2;;
    --kind) KIND="$2"; PROP_ARGS+=("$1" "$2"); shift 2;;
    --label|--height|--color|--solid|--cover|--footprint|--footprint-width|--footprint-depth)
      PROP_ARGS+=("$1" "$2"); shift 2;;
    *) echo "[genprop] unknown option: $1" >&2; exit 2;;
  esac
done

# Ensure the generation venv exists; bootstrap it on first run.
if [[ ! -x "$VENV_PY" ]]; then
  echo "[genprop] generation venv missing — running setup.sh (one-time, downloads model libs)…" >&2
  bash "$GENMESH_DIR/setup.sh"
fi

# Slug for default kind / temp filename.
slug() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

if [[ -f "$INPUT" ]]; then
  GEN_INPUT=(--image "$INPUT")
  BASE="$(basename "${INPUT%.*}")"
else
  GEN_INPUT=(--text "$INPUT")
  BASE="$(slug "$INPUT")"
fi
[[ -z "$BASE" ]] && BASE="mesh"
[[ -z "$KIND" ]] && KIND="imported.$BASE" && PROP_ARGS+=(--kind "$KIND")

# Generate the GLB (kept if --keep-glb, else a temp under data/).
if [[ -n "$KEEP_GLB" ]]; then
  GLB="$KEEP_GLB"
else
  GLB="$(mktemp -t "genprop-$BASE-XXXX.glb")"
  trap 'rm -f "$GLB"' EXIT
fi
mkdir -p "$(dirname "$GLB")"

echo "[genprop] generating mesh for $KIND …" >&2
"$VENV_PY" "$GENMESH_DIR/genmesh.py" --out "$GLB" "${GEN_INPUT[@]}" "${GEN_ARGS[@]}"

echo "[genprop] baking $GLB into the prop registry as $KIND …" >&2
( cd "$REPO_ROOT" && tools/v8cli cart/hmsc-int/tools/importPropMesh.mjs "$GLB" "${PROP_ARGS[@]}" )

echo "[genprop] done — $KIND is now a placeable prop." >&2
