# commands.cmds — the captured console vocabulary, replayed headless (V19).
# Every line below is a REAL captured command (game/commands/vocabulary.ts) —
# the same language the console speaks and the verify bot replays. Not-yet
# commands are deliberately absent: they fail loudly until their capture lane
# lands, and a verify script must stay green.
boot
tick 5

# player vocabulary: cheats gate, movement, speeds
cmd_cheats 1
pv_noclip 1
pv_noclip 0
pv_teleport 12 -7 1.5
pv_speed run 6.5
pv_where

# sky + view vocabulary (P2 tables: named hours, presets, clamps)
gv_time dusk
gv_daycycle 1 2
gv_weather storm
gv_view 240 10 400
gv_sky

# world inspection through the captured kind registry (GAME_KINDS)
wv_tile road
wv_prop kinds
gv_noise

# runtime diagnostics control (PERFLOG-0605)
log status
log all on
log overhead 1000000
log dump verify.commands
log all off
gv_perflog 1
gv_perflog 0

# entity vocabulary (spawn tuning tables)
ev_spawn crate 12 -7 3
ev_burst 8
ev_despawn crate_0000

# event channel + dot-path state surgery
gv_emit verify.commands '{"script":"commands.cmds"}'
gv_events 3
gv_set player.physics.grounded true
gv_config sky.gloom 0.2
gv_scene verify.commands
gv_save
pv_teleport 99 99 9
gv_load
pv_where

tick 40
status
