#!/bin/sh
set -e
cd "$(dirname "$0")"
ROOT=../../..
ESBUILD="$ROOT/tools/esbuild"
V8CLI="$ROOT/tools/v8cli"
# Fall back to fresh build if tools/v8cli is busy (another session running it)
[ -x "$ROOT/zig-out/bin/v8cli" ] && [ "$ROOT/zig-out/bin/v8cli" -nt "$V8CLI" ] && V8CLI="$ROOT/zig-out/bin/v8cli"

# Ensure react / react-reconciler / scheduler are populated from vendor/.
# node_modules is gitignored — bun followed symlinks back into vendor/ and
# couldn't find dependencies, so we materialize copies (one-time, ~1.6MB).
NM=../node_modules
if [ ! -d "$NM/react-reconciler/cjs" ]; then
  mkdir -p "$NM"
  for pkg in react react-reconciler scheduler loose-envify js-tokens; do
    [ -d "$NM/$pkg" ] || cp -RL "$ROOT/vendor/$pkg" "$NM/$pkg"
  done
fi

# Read terminal size; baked into the bundle as compile-time constants.
SIZE=$(stty size 2>/dev/null || echo "24 80")
ROWS=$(echo "$SIZE" | cut -d' ' -f1)
COLS=$(echo "$SIZE" | cut -d' ' -f2)

"$ESBUILD" \
  --bundle entry.tsx \
  --outfile=bundle.js \
  --platform=neutral \
  --main-fields=module,main \
  --target=es2020 \
  --jsx=automatic \
  --jsx-import-source=react \
  --format=cjs \
  --define:process.env.NODE_ENV='"production"' \
  --define:__TUI_COLS__=$COLS \
  --define:__TUI_ROWS__=$ROWS \
  --log-level=warning \
  --resolve-extensions=.tsx,.ts,.jsx,.js \
  --conditions=default \
  --loader:.js=js

"$V8CLI" bundle.js
