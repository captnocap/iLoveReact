# Wave manifest: files each wave may touch (workdir copies + promote targets).
# Sourced by build-workdir.sh and grade-wave.sh. Paths repo-relative.
# EVERY wave includes framework/gpu/3d.zig unless noted.

wave_files() {
  case "$1" in
    W1) echo "framework/gpu/3d.zig framework/gpu/paint_program.zig framework/gpu/model_source.zig" ;;
    W2) echo "framework/gpu/3d.zig framework/gpu/mesh_edit.zig framework/math/geo.zig" ;;
    W3) echo "framework/gpu/3d.zig" ;;
    W4) echo "framework/gpu/3d.zig" ;;
    W5) echo "framework/gpu/3d.zig" ;;
    W6) echo "framework/gpu/3d.zig" ;;
    W7) echo "framework/gpu/3d.zig" ;;
    W8) echo "framework/gpu/3d.zig" ;;
    W9) echo "framework/gpu/3d.zig" ;;
    OF1) echo "framework/gpu/mesh_edit.zig" ;;
    OF2) echo "framework/gpu/model_paint.zig" ;;
    OF3) echo "framework/gpu/world_window.zig framework/gpu/panel_window.zig" ;;
    OF4) echo "" ;;  # read-only analysis: no promote targets
    *) echo "UNKNOWN-WAVE" >&2; return 1 ;;
  esac
}

wave_model() {
  case "$1" in
    W1) echo "gpt-5.3-codex-spark" ;;
    W5|W6|OF4) echo "gpt-5.6-sol" ;;
    OF1|OF2) echo "gpt-5.6-luna" ;;
    *) echo "" ;;  # empty = terra default (no -m flag)
  esac
}
