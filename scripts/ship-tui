#!/bin/sh
# scripts/ship-tui — build a TUI cart into a self-extracting binary.
#
# Same shape as scripts/ship: gzip+tar the ELF behind a #!/bin/sh wrapper
# that extracts to ~/.cache/reactjit-<name>/<sig>/ on first run and execs
# the real binary. V8 doesn't compress well (~2.7×), but raw ELFs are
# bigger than they need to be and gzip is the proven shipping format the
# rest of the SDK uses.
#
# Pipeline:
#   1. esbuild → tui/.cache/bundle-<name>.js               (TUI entry + cart aliased in)
#   2. zig build app -Dhas-gpu=false -Dapp-name=<name>     → zig-out/bin/<name>
#      -Dbundle-path=<absolute path>                       (bundle baked in via @embedFile)
#   3. strip + tar.gz + self-extracting wrapper            → zig-out/bin/<name>
#
# Unified v8_app entry point — same binary target as scripts/ship, just
# flipped into headless mode. v8_tui_app.zig + the tui-app build target
# were retired in C3 once v8_app.runHeadless() was proven equivalent.
#
# No `lib/` dir is bundled because the TUI host has no non-system .so
# deps (only libc/libm/ld-linux, all universal). The tarball is just
# `{ app.bin, run }`.
#
# Usage:  scripts/ship-tui <cart-entry.tsx>
#         scripts/ship-tui tui/devshell/Shell.tsx
#         scripts/ship-tui cart/somecart.tsx

set -e
cd "$(dirname "$0")/.."
ROOT="$PWD"

if [ -z "${1:-}" ]; then
  echo "usage: scripts/ship-tui <cart-entry.tsx>" >&2
  exit 2
fi

ENTRY="$1"
case "$ENTRY" in
  /*) ENTRY_ABS="$ENTRY" ;;
  *)  ENTRY_ABS="$ROOT/$ENTRY" ;;
esac
[ -f "$ENTRY_ABS" ] || { echo "[ship-tui] missing entry: $ENTRY" >&2; exit 2; }

NAME=$(basename "$ENTRY_ABS" .tsx)
ESBUILD="$ROOT/tools/esbuild"
ZIG="${REACTJIT_ZIG:-$ROOT/tools/zig/zig}"
[ -x "$ZIG" ] || ZIG=zig

# react / react-reconciler / scheduler vendored copies live under
# tui/node_modules so the existing scripts/tui aliasing continues to work
# (even though we override with --alias:, esbuild's resolver still scans).
NM="$ROOT/tui/node_modules"
if [ ! -d "$NM/react-reconciler/cjs" ]; then
  mkdir -p "$NM"
  for pkg in react react-reconciler scheduler loose-envify js-tokens; do
    [ -d "$NM/$pkg" ] || cp -RL "$ROOT/deps/$pkg" "$NM/$pkg"
  done
fi

OUT_BUNDLE="$ROOT/tui/.cache/bundle-$NAME.js"
mkdir -p "$ROOT/tui/.cache"

# Terminal size at build time is irrelevant for the shipped binary (the
# JS preamble re-reads it at boot via __termSize), but esbuild still wants
# values for the defines.
SIZE=$(stty size 2>/dev/null || echo "24 80")
ROWS=$(echo "$SIZE" | cut -d' ' -f1)
COLS=$(echo "$SIZE" | cut -d' ' -f2)

echo "[ship-tui] bundling $ENTRY → $OUT_BUNDLE"
"$ESBUILD" \
  --bundle "$ROOT/tui/entry.tsx" \
  --outfile="$OUT_BUNDLE" \
  --metafile="$OUT_BUNDLE.metafile.json" \
  --platform=neutral \
  --main-fields=module,main \
  --target=es2020 \
  --jsx=automatic \
  --jsx-import-source=react \
  --format=cjs \
  --define:process.env.NODE_ENV='"production"' \
  --define:__TUI_COLS__=$COLS \
  --define:__TUI_ROWS__=$ROWS \
  --log-level=warning \
  --resolve-extensions=.tsx,.ts,.jsx,.js \
  --conditions=default \
  --alias:@cart-entry="$ENTRY_ABS" \
  --alias:@reactjit/core="$ROOT/runtime/core_stub.ts" \
  --alias:@reactjit/runtime="$ROOT/runtime" \
  --alias:react="$ROOT/deps/react" \
  --alias:react-reconciler="$ROOT/deps/react-reconciler" \
  --alias:scheduler="$ROOT/deps/scheduler" \
  --alias:loose-envify="$ROOT/deps/loose-envify" \
  --alias:js-tokens="$ROOT/deps/js-tokens"

# Source-driven feature gate. Same metafile walker scripts/ship uses —
# scripts/ship-metafile-gate.js inspects which runtime/hooks/*.ts files
# survived tree-shaking and emits one space-separated line of 0/1 flags
# in this exact order:
#   privacy useHost useConn fs ws tel zigcall sdk voice whisper pg embed
#   sqlite terminal process
METAFILE="$OUT_BUNDLE.metafile.json"
HTTPSRV_FLAG=""
WSSRV_FLAG=""
PROCESS_FLAG=""
NET_FLAG=""
SDK_FLAG=""
FS_FLAG=""
WINDOW_FLAG=""
if [ -f "$METAFILE" ]; then
    GATE_FLAGS=$("$ROOT/tools/v8cli" "$ROOT/scripts/ship-metafile-gate.js" "$METAFILE")
    if [ -z "$GATE_FLAGS" ]; then
        echo "[ship-tui] FATAL: ship-metafile-gate.js produced no output." >&2
        exit 1
    fi
    # shellcheck disable=SC2086
    set -- $GATE_FLAGS
    # Source of truth: sdk/dependency-registry.json shipGate.flagOrder.
    # As of this commit:
    #   $1=privacy   $2=useHost   $3=useConn   $4=fs   $5=ws    $6=tel
    #   $7=zigcall   $8=sdk       $9=voice    $10=audio_input  $11=whisper
    #  $12=paintable $13=onnx    $14=pg       $15=embed       $16=sqlite
    #  $17=terminal  $18=process $19=window   $20=doom
    # Stale comments cause silently-wrong build flags — keep this block
    # in lockstep with the registry's flagOrder array. Mismatch = the
    # gate emits a `1` in a slot we read as a different ingredient.
    WANT_PRIVACY=$1
    WANT_USEHOST=$2
    WANT_USECONN=$3
    WANT_FS=$4
    WANT_WS=$5
    WANT_TEL=$6
    WANT_ZIGCALL=$7
    WANT_SDK=$8
    WANT_WHISPER=${11}
    WANT_ONNX=${13}
    WANT_PG=${14}
    WANT_EMBED=${15}
    WANT_PROCESS=${18}
    WANT_WINDOW=${19}
    if [ "$WANT_USEHOST" = "1" ]; then
        HTTPSRV_FLAG="-Dhas-httpsrv=true"
        WSSRV_FLAG="-Dhas-wssrv=true"
        PROCESS_FLAG="-Dhas-process=true"
    elif [ "$WANT_PROCESS" = "1" ]; then
        PROCESS_FLAG="-Dhas-process=true"
    fi
    if [ "$WANT_USEHOST" = "1" ] || [ "$WANT_USECONN" = "1" ]; then
        NET_FLAG="-Dhas-net=true"
    fi
    if [ "$WANT_SDK" = "1" ]; then
        SDK_FLAG="-Dhas-sdk=true"
    fi
    if [ "$WANT_FS" = "1" ]; then
        FS_FLAG="-Dhas-fs=true"
    fi
    # Pure-Zig bindings — same INGREDIENTS catalog the GPU shell pulls
    # from. No SDL link cost; they just register __X_* host fns when
    # the cart's bundle metafile says the corresponding runtime/hooks
    # file made it past tree-shake. See framework/v8_ingredients.zig.
    [ "$WANT_PRIVACY" = "1" ] && PRIVACY_FLAG="-Dhas-privacy=true"
    [ "$WANT_WS" = "1" ]      && WS_FLAG="-Dhas-websocket=true"
    [ "$WANT_TEL" = "1" ]     && TEL_FLAG="-Dhas-telemetry=true"
    [ "$WANT_ZIGCALL" = "1" ] && ZIGCALL_FLAG="-Dhas-zigcall=true"
    [ "$WANT_PG" = "1" ]      && PG_FLAG="-Dhas-pg=true"
    [ "$WANT_EMBED" = "1" ]   && EMBED_FLAG="-Dhas-embed=true"
    [ "$WANT_WHISPER" = "1" ] && WHISPER_FLAG="-Dhas-whisper=true"
    [ "$WANT_ONNX" = "1" ]    && ONNX_FLAG="-Dhas-onnx=true"
    if [ "$WANT_WINDOW" = "1" ]; then
        # Auto-fires when the cart imports <Window>/<Notification> from
        # @reactjit/runtime/primitives. ship-tui keys SDL3 + the window
        # engine subset off this flag so an otherwise-ANSI binary can
        # paint a <Window> subtree as a real GPU window from inside the
        # same React tree. Currently informational — the link wiring is
        # blocked on extracting v8_app.zig:applyCommandBatch (and the
        # Node-tree state it touches) into a shared module.
        WINDOW_FLAG="-Dhas-window=true"
    fi
fi

echo "[ship-tui] zig build app -Dhas-gpu=false -Dapp-name=$NAME $HTTPSRV_FLAG $WSSRV_FLAG $PROCESS_FLAG $NET_FLAG $SDK_FLAG $FS_FLAG $WINDOW_FLAG $PRIVACY_FLAG $WS_FLAG $TEL_FLAG $ZIGCALL_FLAG $PG_FLAG $EMBED_FLAG $WHISPER_FLAG $ONNX_FLAG"
# Unified app target with -Dhas-gpu=false produces the headless binary
# (no SDL/wgpu link, v8_app's runHeadless() body instead of engine.run).
# The dedicated tui-app target was deleted in C3; v8_app is the single
# entry point now.
#
# -Dhas-terminal=true links libvterm and brings in framework/vterm_real
# so the host's <Terminal> renderer can spawn shells and read cells.
# libvterm is ~70KB statically; no reason to gate this off by default.
"$ZIG" build app \
  -Dhas-gpu=false \
  -Doptimize=ReleaseFast \
  -Dapp-name="$NAME" \
  -Dbundle-path="$OUT_BUNDLE" \
  -Dhas-terminal=true \
  $HTTPSRV_FLAG $WSSRV_FLAG $PROCESS_FLAG $NET_FLAG $SDK_FLAG $FS_FLAG $WINDOW_FLAG \
  $PRIVACY_FLAG $WS_FLAG $TEL_FLAG $ZIGCALL_FLAG $PG_FLAG $EMBED_FLAG $WHISPER_FLAG $ONNX_FLAG

OUT_BIN="$ROOT/zig-out/bin/$NAME"
if [ ! -x "$OUT_BIN" ]; then
  echo "[ship-tui] build did not produce $OUT_BIN" >&2
  exit 1
fi

# Strip debug info before packaging (drops ~15MB of dwarf sections).
strip "$OUT_BIN" 2>/dev/null || true
ELF_SIZE=$(stat -c%s "$OUT_BIN" 2>/dev/null || stat -f%z "$OUT_BIN")

# Self-extracting wrapper, same shape as scripts/ship. No `lib/` dir
# because the TUI host has no non-system .so deps — the tarball is just
# `{ app.bin, run }`. gzip alone takes the V8-heavy ELF down ~3×.
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR" "/tmp/reactjit-tui-${NAME}-payload.tar.gz"' EXIT

cp "$OUT_BIN" "$TMP_DIR/app.bin"
chmod +x "$TMP_DIR/app.bin"

cat > "$TMP_DIR/run" << 'LAUNCHER'
#!/bin/sh
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/app.bin" "$@"
LAUNCHER
chmod +x "$TMP_DIR/run"

TARBALL="/tmp/reactjit-tui-${NAME}-payload.tar.gz"
(cd "$TMP_DIR" && tar czf "$TARBALL" .)

STAGED="${OUT_BIN}.staged"
cat > "$STAGED" << HEADER
#!/bin/sh
set -e
APP_DIR=\${XDG_CACHE_HOME:-\$HOME/.cache}/reactjit-$NAME
SIG=\$(md5sum "\$0" 2>/dev/null | cut -c1-8 || cksum "\$0" | cut -d" " -f1)
CACHE="\$APP_DIR/\$SIG"
if [ ! -f "\$CACHE/.ready" ]; then
  rm -rf "\$APP_DIR"
  mkdir -p "\$CACHE"
  SKIP=\$(awk '/^__ARCHIVE__\$/{print NR + 1; exit}' "\$0")
  tail -n+"\$SKIP" "\$0" | tar xz -C "\$CACHE"
  touch "\$CACHE/.ready"
fi
exec "\$CACHE/run" "\$@"
__ARCHIVE__
HEADER
cat "$TARBALL" >> "$STAGED"
chmod +x "$STAGED"
mv -f "$STAGED" "$OUT_BIN"

WRAPPED_SIZE=$(stat -c%s "$OUT_BIN" 2>/dev/null || stat -f%z "$OUT_BIN")
echo "[ship-tui] done: $OUT_BIN  (ELF $((ELF_SIZE / 1024 / 1024))MB → wrapped $((WRAPPED_SIZE / 1024 / 1024))MB)"
