#!/bin/bash
# ship — build a .tsx cart into a self-extracting native binary.
#
# Pipeline:
#   1. esbuild cart/<name>.tsx → bundle-<name>.js (in CART_ROOT)
#   2. zig build app → zig-out/bin/<name> (ELF, dynamic-linked, bundle embedded)
#   3. Package as self-extracting shell wrapper:
#      - ldd the binary, bundle every non-system .so into a lib/ dir
#      - bundle ld-linux loader
#      - tarball { app.bin, lib/, run } together
#      - prepend shell wrapper that extracts to ~/.cache/reactjit-<name>/<sig>/
#        on first run and execs the real binary via the bundled ld-linux
#
# Result: a single-file shippable binary with zero system dependencies.
# LuaJIT stays dynamic at link time (fast builds) but ships bundled (portable).
#
# Two modes (transparent to the user):
#   In-repo: run from a clone. RJIT_HOME and CART_ROOT both = repo root.
#            Behavior is identical to the pre-split script.
#   rjit-driven: the dispatcher sets RJIT_HOME to its SDK install (a
#            ~/.cache/rjit/<sig>/ dir). CART_ROOT is the user's cwd.
#            build.zig + tools + scripts + framework + runtime live under
#            RJIT_HOME; cart inputs and build outputs live under CART_ROOT.
#
# Usage:
#   scripts/ship <cart-name>          # release, self-extracting

set -euo pipefail

# CART_ROOT is the user's project (where cart/<name>.tsx lives, and where
# bundle-<name>.js, zig-out/, tests/ get written). RJIT_HOME is the SDK
# install (where build.zig, tools/, scripts/, framework/, runtime/ live).
CART_ROOT="$PWD"
RJIT_HOME="${RJIT_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$RJIT_HOME"
OS="$(uname -s)"

# Prefer the SDK-bundled zig (tools/zig/zig) over whatever's on PATH —
# Whonix and other minimal distros don't have a system zig and would
# fail with "zig: command not found" otherwise.
ZIG="${REACTJIT_ZIG:-$RJIT_HOME/tools/zig/zig}"
if [[ ! -x "$ZIG" ]]; then
    ZIG="zig"
fi

# Lock guards the SDK's zig-cache against parallel zig-build races on the
# same RJIT_HOME. Multiple ships from different cart dirs against the same
# SDK install must serialize.
LOCK_FILE="$RJIT_HOME/.zig-cache/.ship.lock"
mkdir -p "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "[ship] another build in progress — waiting for lock..."
    flock 9
    echo "[ship] got lock, proceeding"
fi

NAME=""
WANT_FAT=0
for arg in "$@"; do
    case "$arg" in
        --fat)
            WANT_FAT=1
            ;;
        --*)
            echo "[ship] unknown flag: $arg" >&2
            echo "Usage: scripts/ship <cart-name> [--fat]" >&2
            exit 1
            ;;
        *)
            if [[ -n "$NAME" ]]; then
                echo "[ship] unexpected positional arg: $arg" >&2
                echo "Usage: scripts/ship <cart-name> [--fat]" >&2
                exit 1
            fi
            NAME="$arg"
            ;;
    esac
done

if [[ -z "$NAME" ]]; then
    echo "Usage: scripts/ship <cart-name> [--fat]" >&2
    echo "  Cart expected at: $CART_ROOT/cart/<cart-name>.tsx" >&2
    echo "  --fat: bundle every .so in deps/sysroot/usr/lib/ (Whonix-class hosts" >&2
    echo "         with stripped-out runtime libs); default skips the catch-all." >&2
    exit 1
fi

# Resolve cart entry under CART_ROOT: prefer cart/<name>/index.tsx (directory
# layout), fall back to cart/<name>.tsx (single-file cart). Directory wins.
if [[ -f "$CART_ROOT/cart/${NAME}/index.tsx" ]]; then
    CART_FILE="$CART_ROOT/cart/${NAME}/index.tsx"
elif [[ -f "$CART_ROOT/cart/${NAME}.tsx" ]]; then
    CART_FILE="$CART_ROOT/cart/${NAME}.tsx"
else
    echo "[ship] not found: $CART_ROOT/cart/${NAME}/index.tsx or $CART_ROOT/cart/${NAME}.tsx" >&2
    exit 1
fi
CART_DIR="$(dirname "$CART_FILE")"
CART_MANIFEST="$CART_ROOT/cart/${NAME}/cart.json"

resolve_icon_path() {
    local value="$1"
    if [[ -z "$value" ]]; then
        return 1
    fi
    if [[ "$value" = /* ]]; then
        [[ -f "$value" ]] && { printf '%s\n' "$value"; return 0; }
    else
        [[ -f "$CART_DIR/$value" ]] && { printf '%s\n' "$CART_DIR/$value"; return 0; }
        [[ -f "$CART_ROOT/$value" ]] && { printf '%s\n' "$CART_ROOT/$value"; return 0; }
    fi
    return 1
}

ICON_SOURCE=""
ICON_DECLARED=""
if [[ -f "$CART_MANIFEST" ]]; then
    if [[ "$OS" == "Darwin" ]]; then
        ICON_DECLARED="$(tools/v8cli scripts/cart-manifest-field.js "$CART_MANIFEST" icons.macos || true)"
    elif [[ "$OS" == "Linux" ]]; then
        ICON_DECLARED="$(tools/v8cli scripts/cart-manifest-field.js "$CART_MANIFEST" icons.linux || true)"
    fi
    if [[ -z "$ICON_DECLARED" ]]; then
        ICON_DECLARED="$(tools/v8cli scripts/cart-manifest-field.js "$CART_MANIFEST" icons.default || true)"
    fi
    if [[ -z "$ICON_DECLARED" ]]; then
        ICON_DECLARED="$(tools/v8cli scripts/cart-manifest-field.js "$CART_MANIFEST" icon || true)"
    fi
    if [[ -n "$ICON_DECLARED" ]]; then
        if ! ICON_SOURCE="$(resolve_icon_path "$ICON_DECLARED")"; then
            echo "[ship] cart manifest icon not found: $ICON_DECLARED" >&2
            echo "[ship] icon paths are resolved relative to $CART_DIR, then $CART_ROOT" >&2
            exit 1
        fi
    fi
fi
if [[ -z "$ICON_SOURCE" ]]; then
    for candidate in \
        "$CART_ROOT/cart/${NAME}/icon.icns" \
        "$CART_ROOT/cart/${NAME}/icon.png" \
        "$CART_ROOT/cart/${NAME}/icon.svg" \
        "$CART_ROOT/cart/${NAME}/icon.ico" \
        "$CART_ROOT/cart/${NAME}.icns" \
        "$CART_ROOT/cart/${NAME}.png" \
        "$CART_ROOT/cart/${NAME}.svg" \
        "$CART_ROOT/cart/${NAME}.ico"
    do
        if [[ -f "$candidate" ]]; then
            ICON_SOURCE="$candidate"
            break
        fi
    done
fi
ICON_EXT=""
ICON_FILE=""
if [[ -n "$ICON_SOURCE" ]]; then
    ICON_EXT="${ICON_SOURCE##*.}"
    ICON_EXT="${ICON_EXT,,}"
    ICON_FILE="${NAME}.${ICON_EXT}"
    echo "[ship] app icon: $ICON_SOURCE"
fi

# ── 1. Bundle cart entry via esbuild → bundle-<name>.js ──────────────
# Bundle output lives in CART_ROOT so the user's project owns its build
# artefacts. zig build embeds it via -Dbundle-path so v8_app.zig's
# @embedFile resolves the absolute path (instead of the SDK-relative
# default).
BUNDLE_OUT="$CART_ROOT/bundle-${NAME}.js"

# Heal top-level `const { useX } = React;` and stray require('react') lines —
# patterns that fail at module-init before globalThis.React is set.
# fix-react-imports honors RJIT_HOME + CART_ROOT env when set.
RJIT_HOME="$RJIT_HOME" CART_ROOT="$CART_ROOT" scripts/fix-react-imports

echo "[ship] bundling $CART_FILE → $BUNDLE_OUT..."
BUNDLE_FROM_HARNESS=1 CART_ROOT="$CART_ROOT" tools/v8cli scripts/cart-bundle.js "$CART_FILE" --out "$BUNDLE_OUT"

# Zig's @embedFile rejects absolute paths outside the build.zig package
# (RJIT_HOME). When CART_ROOT differs (rjit-driven mode), the bundle just
# written under CART_ROOT cannot be embedded directly; mirror it into a
# package-local dir so the embed path lands inside the package. Avoid
# .zig-cache/ — Zig excludes it from package paths.
EMBED_BUNDLE="$BUNDLE_OUT"
if [[ "$CART_ROOT" != "$RJIT_HOME" ]]; then
    EMBED_BUNDLE="$RJIT_HOME/bundles/bundle-${NAME}.js"
    mkdir -p "$(dirname "$EMBED_BUNDLE")"
    cp -f "$BUNDLE_OUT" "$EMBED_BUNDLE"
fi

# ── 2. Compile v8_app.zig (bundle-<name>.js embedded via @embedFile) ─
OPT_FLAG="-Doptimize=ReleaseFast"

echo "[ship] compiling native binary..."
APP_SOURCE="framework/v8_app.zig"
V8_FLAG="-Duse-v8=true"

# Cart-declared capabilities (cart/<name>/cart.json). The runtime reads
# `customChrome: true` as build_options.custom_chrome to decide borderless
# vs windowed chrome. But customChrome=true alone is dangerous: if the
# cart's React tree never renders a draggable window-control bar (i.e.
# no `windowDrag` prop on any node), the user gets a borderless box with
# no way to move or close it. Force OS chrome in that case.
#
# Detection signal: `windowDrag` literal in the bundled JS. The framework
# uses that prop on the chrome bar's drag region — verified across carts
# (browser has it, media doesn't, icon_bench doesn't). Reliable static
# signal because the prop name is unique to this code path.
CUSTOM_CHROME_FLAG=""
if [[ -f "$CART_MANIFEST" ]] && grep -Eq '"customChrome"[[:space:]]*:[[:space:]]*true' "$CART_MANIFEST"; then
    BUNDLE_FILE_FOR_CHROME="$CART_ROOT/bundle-${NAME}.js"
    if [[ -f "$BUNDLE_FILE_FOR_CHROME" ]] && grep -q "windowDrag" "$BUNDLE_FILE_FOR_CHROME"; then
        CUSTOM_CHROME_FLAG="-Dcustom-chrome=true"
        echo "[ship] cart manifest: customChrome=true (windowDrag detected → borderless)"
    else
        echo "[ship] cart manifest: customChrome=true ignored — no windowDrag in bundle"
        echo "[ship]   (cart has no draggable chrome bar; falling back to OS chrome so user can move/close the window)"
    fi
fi

# Detect optional capabilities by scanning the just-built bundle.
# Each capability flag links its corresponding system library and pulls in
# the relevant framework binding. Source-driven: cart says "I use X", we
# ship X. Cart doesn't say, we don't.
# Read the esbuild metafile (sidecar to the bundle, written by cart-bundle.js
# via --metafile). The metafile's `inputs` map lists every source file that
# survived tree-shaking — the structural truth of what's actually in the
# bundle. We check whether specific hook source paths appear there to gate
# V8 binding registration. No grep, no text matching, no false positives
# from comments/strings/identifier collisions.
#
# Hook → ingredients mapping (ingredient = one V8 binding file):
#   runtime/hooks/useHost.ts    → enables process + httpsrv + wssrv together
#   runtime/hooks/usePrivacy.ts → enables privacy
#
# Ingredient-level granularity, not flavor-level: useHost has process/http/ws
# flavors but importing the file at all means register all three. Same way
# usePrivacy has thirty flavors and registering brings them all.
METAFILE="$BUNDLE_OUT.metafile.json"
PRIVACY_FLAG=""
PROCESS_FLAG=""
HTTPSRV_FLAG=""
WSSRV_FLAG=""
NET_FLAG=""
TOR_FLAG=""
FS_FLAG=""
WS_FLAG=""
TEL_FLAG=""
ZIGCALL_FLAG=""
SDK_FLAG=""
VOICE_FLAG=""
WHISPER_FLAG=""
PAINTABLE_FLAG=""
PHYSICS_LAB_FLAG=""
GAME_PHYSICS_FLAG=""
ONNX_FLAG=""
PG_FLAG=""
EMBED_FLAG=""
SQLITE_FLAG=""
TERMINAL_FLAG=""
DOOM_FLAG=""
WANT_PRIVACY=0
WANT_USEHOST=0
WANT_USECONN=0
WANT_FS=0
WANT_WS=0
WANT_TEL=0
WANT_ZIGCALL=0
WANT_SDK=0
WANT_VOICE=0
WANT_WHISPER=0
WANT_PG=0
WANT_EMBED=0
WANT_SQLITE=0
WANT_TERMINAL=0
WANT_PHYSICS_LAB=0
WANT_GAME_PHYSICS=0
if [[ -f "$METAFILE" ]]; then
    # Pure JSON membership check — v8cli reads the metafile, walks
    # outputs[].inputs (bytes-actually-shipped), and emits a single line of
    # space-separated 0/1 flags in this exact order:
    #   privacy useHost useConnection fs websocket telemetry zigcall sdk
    # See scripts/ship-metafile-gate.js for the hook→binding map.
    GATE_FLAGS=$(tools/v8cli scripts/ship-metafile-gate.js "$METAFILE")
    if [[ -z "$GATE_FLAGS" ]]; then
        echo "[ship] FATAL: ship-metafile-gate.js produced no output." >&2
        echo "[ship] Without the gate, every binding would be force-disabled and" >&2
        echo "[ship] any cart that uses a gated hook would crash at runtime." >&2
        exit 1
    fi
    # Order MUST match sdk/dependency-registry.json shipGate.flagOrder. The
    # JS gate already emits 17 positional flags; this read line was lagging
    # behind onnx + window additions, so WANT_TERMINAL was silently picking
    # up sqlite's value (always 0). Keep in lock-step with flagOrder.
    read -r WANT_PRIVACY WANT_USEHOST WANT_USECONN WANT_FS WANT_WS WANT_TEL WANT_ZIGCALL WANT_SDK WANT_VOICE WANT_AUDIO_INPUT WANT_WHISPER WANT_PAINTABLE WANT_ONNX WANT_PG WANT_EMBED WANT_SQLITE WANT_TERMINAL WANT_PROCESS WANT_WINDOW WANT_DOOM <<< "$GATE_FLAGS"
    # Process binding is a strict subset of useHost (useHost pulls in process +
    # httpsrv + wssrv + net). Carts that import runtime/hooks/process.ts
    # directly (run/execAsync) only need the process binding.
    if [[ "$WANT_PROCESS" == "1" ]] && [[ "$WANT_USEHOST" != "1" ]]; then
        PROCESS_FLAG="-Dhas-process=true"
    fi
    if [[ "$WANT_PRIVACY" == "1" ]]; then
        PRIVACY_FLAG="-Dhas-privacy=true"
    fi
    if [[ "$WANT_USEHOST" == "1" ]]; then
        PROCESS_FLAG="-Dhas-process=true"
        HTTPSRV_FLAG="-Dhas-httpsrv=true"
        WSSRV_FLAG="-Dhas-wssrv=true"
    fi
    # useHost or useConnection both need the net binding (tcp/udp/socks5).
    if [[ "$WANT_USEHOST" == "1" ]] || [[ "$WANT_USECONN" == "1" ]]; then
        NET_FLAG="-Dhas-net=true"
    fi
    if [[ "$WANT_USECONN" == "1" ]]; then
        TOR_FLAG="-Dhas-tor=true"
    fi
    if [[ "$WANT_FS" == "1" ]]; then
        FS_FLAG="-Dhas-fs=true"
    fi
    if [[ "$WANT_WS" == "1" ]]; then
        WS_FLAG="-Dhas-websocket=true"
    fi
    if [[ "$WANT_TEL" == "1" ]]; then
        TEL_FLAG="-Dhas-telemetry=true"
    fi
    if [[ "$WANT_ZIGCALL" == "1" ]]; then
        ZIGCALL_FLAG="-Dhas-zigcall=true"
    fi
    if [[ "$WANT_SDK" == "1" ]]; then
        SDK_FLAG="-Dhas-sdk=true"
    fi
    if [[ "$WANT_VOICE" == "1" ]]; then
        VOICE_FLAG="-Dhas-voice=true"
    fi
    if [[ "$WANT_WHISPER" == "1" ]]; then
        WHISPER_FLAG="-Dhas-whisper=true"
    fi
    if [[ "$WANT_PAINTABLE" == "1" ]]; then
        PAINTABLE_FLAG="-Dhas-paintable=true"
    fi
    if [[ "$WANT_ONNX" == "1" ]]; then
        ONNX_FLAG="-Dhas-onnx=true"
    fi
    # has-embed implies has-pg (embed.zig pulls in framework/pg.zig).
    if [[ "$WANT_PG" == "1" ]] || [[ "$WANT_EMBED" == "1" ]]; then
        PG_FLAG="-Dhas-pg=true"
    fi
    if [[ "$WANT_SQLITE" == "1" ]]; then
        # libsqlite3 is dlopen'd at runtime by framework/storage/sqlite.zig —
        # no link-time dependency; WANT_SQLITE also gates bundling the .so.
        # __sql_* is its own ingredient now (v8_bindings_sqlite.zig,
        # STOREDB-0606) — the old has-telemetry piggyback is retired.
        SQLITE_FLAG="-Dhas-sqlite=true"
    fi
    if [[ "$WANT_EMBED" == "1" ]]; then
        EMBED_FLAG="-Dhas-embed=true"
    fi
    if [[ "$WANT_TERMINAL" == "1" ]]; then
        # libvterm is linked at -Dhas-terminal=true; the ldd-driven packager
        # below picks it up via the libvterm prefix in BUNDLE_PREFIXES.
        TERMINAL_FLAG="-Dhas-terminal=true"
    fi
    if [[ "$WANT_DOOM" == "1" ]]; then
        DOOM_FLAG="-Dhas-doom=true"
    fi
else
    echo "[ship] WARNING: no metafile at $METAFILE — all opt-in V8 bindings disabled" >&2
fi

if [[ -f "$BUNDLE_OUT" ]] && grep -Eq "__physics_lab_" "$BUNDLE_OUT"; then
    WANT_PHYSICS_LAB=1
    PHYSICS_LAB_FLAG="-Dhas-physics-lab=true"
fi
# The game's physics + movement (framework/game/, V18). __hmsc_* is the
# legacy-named call surface hmsc carts grew up with; __game_physics_* the
# honest alias.
if [[ -f "$BUNDLE_OUT" ]] && grep -Eq "__hmsc_|__game_physics_" "$BUNDLE_OUT"; then
    WANT_GAME_PHYSICS=1
    GAME_PHYSICS_FLAG="-Dhas-game-physics=true"
fi

BUILD_BINDINGS=()
BUILD_LIBS=()
BUILD_TRIGGERS=()
if [[ "$WANT_PRIVACY" == "1" ]]; then
    BUILD_BINDINGS+=("privacy")
    BUILD_LIBS+=("libsodium")
    BUILD_TRIGGERS+=("privacy: runtime/hooks/usePrivacy.ts")
fi
if [[ "$WANT_USEHOST" == "1" ]]; then
    BUILD_BINDINGS+=("process" "httpsrv" "wssrv")
    BUILD_TRIGGERS+=("useHost: runtime/hooks/useHost.ts")
elif [[ "$WANT_PROCESS" == "1" ]]; then
    BUILD_BINDINGS+=("process")
    BUILD_TRIGGERS+=("process: runtime/hooks/process.ts")
fi
if [[ "$WANT_USEHOST" == "1" ]] || [[ "$WANT_USECONN" == "1" ]]; then
    BUILD_BINDINGS+=("net")
fi
if [[ "$WANT_USECONN" == "1" ]]; then
    BUILD_BINDINGS+=("tor")
    BUILD_TRIGGERS+=("connection: runtime/hooks/useConnection.ts")
fi
if [[ "$WANT_FS" == "1" ]]; then
    BUILD_BINDINGS+=("fs")
    BUILD_TRIGGERS+=("fs: runtime/hooks/fs.ts")
fi
if [[ "$WANT_WS" == "1" ]]; then
    BUILD_BINDINGS+=("websocket")
    BUILD_TRIGGERS+=("websocket: runtime/hooks/websocket.ts or useConnection")
fi
if [[ "$WANT_TEL" == "1" ]]; then
    BUILD_BINDINGS+=("telemetry")
    BUILD_TRIGGERS+=("telemetry: telemetry cart source")
fi
if [[ "$WANT_SQLITE" == "1" ]]; then
    BUILD_BINDINGS+=("sqlite")
    BUILD_TRIGGERS+=("sqlite: runtime/hooks/sqlite.ts or localstore")
fi
if [[ "$WANT_ZIGCALL" == "1" ]]; then
    BUILD_BINDINGS+=("zigcall" "zigcall_list")
    BUILD_TRIGGERS+=("zigcall: runtime/hooks/math.ts")
fi
if [[ "$WANT_SDK" == "1" ]]; then
    BUILD_BINDINGS+=("sdk")
    BUILD_TRIGGERS+=("sdk: runtime/hooks/useTheInternet.ts or runtime/hooks/fetch.ts or runtime/hooks/useFetchBrowser.ts")
fi
if [[ "$WANT_PAINTABLE" == "1" ]]; then
    BUILD_BINDINGS+=("paintable")
    BUILD_TRIGGERS+=("paintable: runtime/hooks/usePaintable.ts")
fi
if [[ "$WANT_PHYSICS_LAB" == "1" ]]; then
    BUILD_BINDINGS+=("physics_lab")
    BUILD_TRIGGERS+=("physics_lab: __physics_lab_* host calls")
fi
if [[ "$WANT_GAME_PHYSICS" == "1" ]]; then
    BUILD_BINDINGS+=("game_physics")
    BUILD_TRIGGERS+=("game_physics: __hmsc_* or __game_physics_* host calls")
fi
if [[ "$WANT_ONNX" == "1" ]]; then
    BUILD_BINDINGS+=("onnx")
    BUILD_LIBS+=("libonnxruntime")
    BUILD_TRIGGERS+=("onnx: runtime/hooks/useSegment.ts")
fi
if [[ "$WANT_PG" == "1" ]] || [[ "$WANT_EMBED" == "1" ]]; then
    BUILD_BINDINGS+=("pg")
    BUILD_TRIGGERS+=("pg: runtime/hooks/pg.ts or runtime/hooks/usePostgres.ts")
fi
if [[ "$WANT_EMBED" == "1" ]]; then
    BUILD_BINDINGS+=("embed")
    BUILD_LIBS+=("libllama_ffi (tsz/zig-out/lib)")
    BUILD_TRIGGERS+=("embed: runtime/hooks/embed.ts or runtime/hooks/useEmbed.ts")
fi
if [[ "$WANT_TERMINAL" == "1" ]]; then
    BUILD_LIBS+=("libvterm")
    BUILD_TRIGGERS+=("terminal: runtime/hooks/useTerminal.ts")
fi

echo "[ship] build ingredients:"
echo "[ship]   runtime: $APP_SOURCE (V8)"
if [[ "${#BUILD_BINDINGS[@]}" -gt 0 ]]; then
    echo "[ship]   V8 bindings: ${BUILD_BINDINGS[*]}"
else
    echo "[ship]   V8 bindings: none"
fi
if [[ "${#BUILD_LIBS[@]}" -gt 0 ]]; then
    echo "[ship]   native feature libs: ${BUILD_LIBS[*]}"
else
    echo "[ship]   native feature libs: none"
fi
if [[ "${#BUILD_TRIGGERS[@]}" -gt 0 ]]; then
    echo "[ship]   triggers:"
    for trigger in "${BUILD_TRIGGERS[@]}"; do
        echo "[ship]     - $trigger"
    done
else
    echo "[ship]   triggers: none"
fi
# Sysroot — when deps/sysroot/ exists in the SDK install, point the build at
# our vendored headers + .so files instead of /usr/include and the system's
# libfoo.so. This is what lets `rjit ship` work on a fresh distro that
# doesn't have libsdl3-dev / libfreetype-dev / etc. installed.
SYSROOT_FLAG=""
SYSROOT_LIB="$RJIT_HOME/deps/sysroot/usr/lib"
if [[ -d "$RJIT_HOME/deps/sysroot/usr/include" ]]; then
    SYSROOT_FLAG="-Dsysroot=$RJIT_HOME/deps/sysroot"

    # Some libs are system-assumed (we never bundle them) but minimal distros
    # like Whonix ship only the SONAME-versioned .so.N — they lack the
    # unversioned dev symlink the linker needs for `-lX11`. Detect those and
    # synthesize the dev symlink in our sysroot pointing at whatever path
    # ldconfig reports for the system .so.
    for sysname in X11; do
        if [[ ! -e "$SYSROOT_LIB/lib${sysname}.so" ]]; then
            sys_so=$(ldconfig -p 2>/dev/null | awk -v rx="lib${sysname}\\.so" '$1 ~ rx {print $NF; exit}')
            if [[ -n "$sys_so" && -e "$sys_so" ]]; then
                ln -sfn "$sys_so" "$SYSROOT_LIB/lib${sysname}.so"
                echo "[ship] sysroot: linked lib${sysname}.so → $sys_so"
            fi
        fi
    done
fi

echo "[ship]   zig flags: $V8_FLAG${CUSTOM_CHROME_FLAG:+ $CUSTOM_CHROME_FLAG} $OPT_FLAG${SYSROOT_FLAG:+ $SYSROOT_FLAG}${PRIVACY_FLAG:+ $PRIVACY_FLAG}${PROCESS_FLAG:+ $PROCESS_FLAG}${HTTPSRV_FLAG:+ $HTTPSRV_FLAG}${WSSRV_FLAG:+ $WSSRV_FLAG}${NET_FLAG:+ $NET_FLAG}${TOR_FLAG:+ $TOR_FLAG}${FS_FLAG:+ $FS_FLAG}${WS_FLAG:+ $WS_FLAG}${TEL_FLAG:+ $TEL_FLAG}${ZIGCALL_FLAG:+ $ZIGCALL_FLAG}${SDK_FLAG:+ $SDK_FLAG}${VOICE_FLAG:+ $VOICE_FLAG}${WHISPER_FLAG:+ $WHISPER_FLAG}${PAINTABLE_FLAG:+ $PAINTABLE_FLAG}${PHYSICS_LAB_FLAG:+ $PHYSICS_LAB_FLAG}${GAME_PHYSICS_FLAG:+ $GAME_PHYSICS_FLAG}${ONNX_FLAG:+ $ONNX_FLAG}${PG_FLAG:+ $PG_FLAG}${EMBED_FLAG:+ $EMBED_FLAG}${SQLITE_FLAG:+ $SQLITE_FLAG}${TERMINAL_FLAG:+ $TERMINAL_FLAG}${DOOM_FLAG:+ $DOOM_FLAG}"

# Zig package cache override — ONLY when running off-tree (rjit-driven).
# In rjit-driven mode the SDK ships a bundled cache at tools/zig/cache/p/
# (overlaid from the dev host's ~/.cache/zig/p at pack-sdk time) so the
# build is hermetic on Whonix etc. In-repo dev uses the default
# ~/.cache/zig which is the authoritative, complete cache.
if [[ "$CART_ROOT" != "$RJIT_HOME" ]]; then
    export ZIG_GLOBAL_CACHE_DIR="$RJIT_HOME/tools/zig/cache"
fi

"$ZIG" build app -p "$CART_ROOT/zig-out" -Dapp-name="$NAME" -Dapp-source="$APP_SOURCE" -Dbundle-path="$EMBED_BUNDLE" $V8_FLAG $CUSTOM_CHROME_FLAG $OPT_FLAG $SYSROOT_FLAG $PRIVACY_FLAG $PROCESS_FLAG $HTTPSRV_FLAG $WSSRV_FLAG $NET_FLAG $TOR_FLAG $FS_FLAG $WS_FLAG $TEL_FLAG $ZIGCALL_FLAG $SDK_FLAG $VOICE_FLAG $WHISPER_FLAG $PAINTABLE_FLAG $PHYSICS_LAB_FLAG $GAME_PHYSICS_FLAG $ONNX_FLAG $PG_FLAG $EMBED_FLAG $SQLITE_FLAG $TERMINAL_FLAG $DOOM_FLAG

BUILD_BIN="$CART_ROOT/zig-out/bin/$NAME"
if [[ ! -f "$BUILD_BIN" ]]; then
    echo "[ship] build produced no binary: $BUILD_BIN" >&2
    exit 1
fi

# ── Allergen-label verification ───────────────────────────────────────
# build.zig writes one .flag per opt-in V8 binding domain to
# zig-out/manifest/v8-ingredients/<name>.flag with "1" or "0". Diff that
# against the cart's pre-build declaration. Any disagreement = the
# kitchen contradicted the label, so the binary is destroyed before
# shipping. There is no "trust us, it's fine" path here — by design.
LABEL_DIR="$CART_ROOT/zig-out/manifest/v8-ingredients"
NET_EXPECTED="0"
[[ "$WANT_USEHOST" == "1" || "$WANT_USECONN" == "1" ]] && NET_EXPECTED="1"
# Process binding is enabled by either useHost (which subsumes it) or a direct
# import of runtime/hooks/process.ts (run/execAsync).
PROCESS_EXPECTED="0"
[[ "$WANT_USEHOST" == "1" || "$WANT_PROCESS" == "1" ]] && PROCESS_EXPECTED="1"
declare -A EXPECTED=(
    [privacy]="$WANT_PRIVACY"
    [process]="$PROCESS_EXPECTED"
    [httpsrv]="$WANT_USEHOST"
    [wssrv]="$WANT_USEHOST"
    [net]="$NET_EXPECTED"
    [tor]="$WANT_USECONN"
    [fs]="$WANT_FS"
    [websocket]="$WANT_WS"
    [telemetry]="$WANT_TEL"
    [sqlite]="$WANT_SQLITE"
    [zigcall]="$WANT_ZIGCALL"
    [physics_lab]="$WANT_PHYSICS_LAB"
    [game_physics]="$WANT_GAME_PHYSICS"
)
LABEL_MISMATCH=0
for ing in privacy process httpsrv wssrv net tor fs websocket telemetry sqlite zigcall physics_lab game_physics; do
    flag_file="$LABEL_DIR/${ing}.flag"
    expected="${EXPECTED[$ing]:-0}"
    if [[ ! -f "$flag_file" ]]; then
        echo "[ship] LABEL MISSING: $flag_file (expected $expected)" >&2
        LABEL_MISMATCH=1
        continue
    fi
    actual=$(cat "$flag_file" | tr -d '[:space:]')
    if [[ "$actual" != "$expected" ]]; then
        echo "[ship] LABEL MISMATCH: $ing — cart asked for '$expected' but binary built '$actual'" >&2
        LABEL_MISMATCH=1
    fi
done
if [[ "$LABEL_MISMATCH" -eq 1 ]]; then
    echo "[ship] DESTROYING binary — manifest disagrees with cart declaration" >&2
    rm -f "$BUILD_BIN"
    exit 1
fi

# Release the SDK build lock. Everything past this point — packaging,
# snapshot gate, autotest replay — writes to cart-namespaced paths
# (zig-out/bin/<name>, /tmp/reactjit-dist-<name>) and runs the binary
# headless. None of it touches .zig-cache or the v8-ingredients manifest,
# so other ships can start their zig build now. Holding the lock through
# the snapshot+autotest phases stalls every parallel ship for up to 15
# minutes (300s snapshot timeout + 600s autotest timeout).
exec 9>&-

# ── 3. Package as self-extracting binary ──────────────────────────────
if [[ "$OS" == "Darwin" ]]; then
    # ── macOS: package as .app bundle ──────────────────────────────
    echo "[ship] packaging macOS .app bundle..."
    APP_BUNDLE="$CART_ROOT/zig-out/bin/${NAME}.app"
    CONTENTS="$APP_BUNDLE/Contents"
    MACOS_DIR="$CONTENTS/MacOS"
    FW_DIR="$CONTENTS/Frameworks"
    RES_DIR="$CONTENTS/Resources"
    rm -rf "$APP_BUNDLE"
    mkdir -p "$MACOS_DIR" "$FW_DIR" "$RES_DIR"
    cp "$BUILD_BIN" "$MACOS_DIR/$NAME"

    MACOS_ICON_PLIST=""
    if [[ -n "$ICON_SOURCE" ]]; then
        cp "$ICON_SOURCE" "$RES_DIR/$ICON_FILE"
        if [[ "$ICON_EXT" == "icns" ]]; then
            MACOS_ICON_PLIST="    <key>CFBundleIconFile</key>
    <string>$ICON_FILE</string>"
        else
            echo "[ship] macOS icon copied to Resources/$ICON_FILE; Finder icon requires .icns" >&2
        fi
    fi

    cat > "$CONTENTS/Info.plist" << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$NAME</string>
    <key>CFBundleIdentifier</key>
    <string>com.reactjit.$NAME</string>
    <key>CFBundleName</key>
    <string>$NAME</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
${MACOS_ICON_PLIST}
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
</dict>
</plist>
PLIST

    # Recursively collect non-system dylibs into Frameworks/
    collect_dylibs() {
        for bin in "$@"; do
            otool -L "$bin" 2>/dev/null | tail -n +2 | awk '{print $1}' | while read -r lib_path; do
                case "$lib_path" in
                    /usr/lib/*|/System/*|@rpath/*|@executable_path/*) continue ;;
                esac
                [ ! -f "$lib_path" ] && continue
                lib_name=$(basename "$lib_path")
                [ -f "$FW_DIR/$lib_name" ] && continue
                cp "$lib_path" "$FW_DIR/$lib_name"
                echo "$lib_name"
            done
        done
    }
    collect_dylibs "$MACOS_DIR/$NAME" >/dev/null
    # Transitive deps from bundled dylibs
    collect_dylibs "$FW_DIR"/*.dylib >/dev/null 2>/dev/null || true

    # Rewrite dylib paths → @executable_path/../Frameworks/
    rewrite_dylib_paths() {
        local bin="$1"
        otool -L "$bin" 2>/dev/null | tail -n +2 | awk '{print $1}' | while read -r lib_path; do
            case "$lib_path" in
                /usr/lib/*|/System/*|@rpath/*|@executable_path/*) continue ;;
            esac
            lib_name=$(basename "$lib_path")
            install_name_tool -change "$lib_path" "@executable_path/../Frameworks/$lib_name" "$bin" 2>/dev/null || true
        done
    }
    rewrite_dylib_paths "$MACOS_DIR/$NAME"
    install_name_tool -add_rpath "@executable_path/../Frameworks" "$MACOS_DIR/$NAME" 2>/dev/null || true

    # Fix each bundled dylib's id + transitive refs
    for dylib in "$FW_DIR"/*.dylib; do
        [ -f "$dylib" ] || continue
        lib_name=$(basename "$dylib")
        install_name_tool -id "@executable_path/../Frameworks/$lib_name" "$dylib" 2>/dev/null || true
        rewrite_dylib_paths "$dylib"
    done

    # Ad-hoc sign (Sequoia requires valid signatures even for unsigned builds)
    codesign --force --sign - --deep "$APP_BUNDLE" 2>/dev/null || true

    LIB_COUNT=$(find "$FW_DIR" -name '*.dylib' 2>/dev/null | wc -l | tr -d ' ')
    SIZE_MB=$(du -sm "$APP_BUNDLE" | cut -f1)
    echo "[ship] done (${SIZE_MB}MB .app bundle, $LIB_COUNT dylibs) → $APP_BUNDLE"
    exit 0
fi

if [[ "$OS" != "Linux" ]]; then
    echo "[ship] packaging not implemented for $OS — leaving build output at $BUILD_BIN"
    exit 0
fi

echo "[ship] packaging self-extracting binary..."
TMP_DIR="/tmp/reactjit-dist-$NAME"
LIB_DIR="$TMP_DIR/lib"
SHARE_DIR="$TMP_DIR/share"
rm -rf "$TMP_DIR"
mkdir -p "$LIB_DIR"
cp "$BUILD_BIN" "$TMP_DIR/app.bin"

# ── llama.cpp inference subprocess (rjit-llm-worker) ───────────────────
# Local-AI carts get the worker binary + libllama.so + the four ggml
# siblings bundled. The worker runs llama.cpp inference in its own
# process so the renderer's wgpu/Vulkan never fights with llama's
# ggml-vulkan over the VkInstance. See framework/ffi/llm_worker.cpp
# and framework/local_ai_runtime.zig for the full architecture.
#
# Gate: WANT_EMBED. This fires on runtime/hooks/embed.ts /
# useEmbed.ts, which means the cart does local LLM-backed embedding
# work and also (if it uses chat) wants the same llama.cpp backend.
# Previously gated on WANT_SDK — broad enough that every cart
# importing fetch.ts / useTheInternet.ts dragged in 165MB of llama
# even though it only ever talked to anthropic over HTTP. Smith-era
# drift the user has been calling out.
#
# useAssistant's `local_ai` backend takes the backend as a runtime
# string, so static analysis can't tell if a chat cart uses local
# inference. If a cart wants useAssistant({ backend:'local_ai' })
# without also touching embeddings, it has to flip has-embed
# explicitly or this block stays off and `__worker_start` will fail
# at runtime with a clear "rjit-llm-worker not bundled" error. Not
# pretty, but better than silent 165MB-per-cart bloat. The proper
# fix is a per-backend import surface for useAssistant.
if [[ "$WANT_EMBED" == "1" ]]; then
    LLM_WORKER_SRC="$RJIT_HOME/zig-out/bin/rjit-llm-worker"
    LLM_LIB_DIR="$RJIT_HOME/deps/llama.cpp-fresh/build/bin"
    if [[ -f "$LLM_WORKER_SRC" ]] && [[ -d "$LLM_LIB_DIR" ]]; then
        cp "$LLM_WORKER_SRC" "$TMP_DIR/rjit-llm-worker"
        chmod +x "$TMP_DIR/rjit-llm-worker"
        # Copy real files for the SONAMEs the worker NEEDS, and add a
        # symlink at the SONAME if upstream named the file with a version
        # suffix (libllama.so.0.0.1 etc). We only need the .so and .so.0
        # forms for runtime resolution.
        for so_pattern in libllama libggml libggml-base libggml-cpu libggml-vulkan; do
            for f in "$LLM_LIB_DIR/${so_pattern}.so"*; do
                [[ -e "$f" ]] || continue
                soname=$(basename "$f")
                real=$(readlink -f "$f")
                cp "$real" "$LIB_DIR/$soname"
            done
        done
        echo "[ship]   bundled rjit-llm-worker + libllama.so + ggml-vulkan backend"
    else
        echo "[ship]   WARNING: has-embed needs $LLM_WORKER_SRC + $LLM_LIB_DIR — skipping local-runtime bundle"
    fi
fi

# ── libmpv (video playback, dlopen-only) ───────────────────────────────
# framework/videos.zig dlopens libmpv.so.2 at first <Video> mount, so it
# never appears in ldd of the cart binary. The own-libs allowlist that
# walks ldd can't see it. But libmpv isn't pre-installed on most hosts
# (Ubuntu/Debian/Fedora/Arch/macOS all need explicit `apt install libmpv2`
# / `brew install mpv`), so relying on the user's system means video
# carts silently no-op for >90% of users.
#
# Detect video usage by grepping the bundled JS for an actual JSX call
# to the Video primitive. esbuild compiles `<Video src=...>` to
# `__jsx(Video, {...})` (or `__jsxs(Video, ...)` with multiple children).
# Naively grepping `videoSrc` triggers on the primitive's declaration
# even when the cart never uses it (tree-shaking keeps the export when
# any sibling primitive from runtime/primitives.tsx is imported).
# The `__jsx(Video,` signal only appears at real call sites.
BUNDLE_FILE="$CART_ROOT/bundle-${NAME}.js"
if [[ -f "$BUNDLE_FILE" ]] && grep -qE "__jsxs?\(Video," "$BUNDLE_FILE"; then
    LIBMPV_SRC="$RJIT_HOME/love2d/storybook/lib/libmpv.so.2"
    if [[ -f "$LIBMPV_SRC" ]]; then
        cp -L "$LIBMPV_SRC" "$LIB_DIR/libmpv.so.2"
        echo "[ship]   bundled libmpv.so.2 (video cart — Video primitive detected)"
    else
        echo "[ship]   WARNING: cart uses Video but pinned libmpv.so.2 not found at $LIBMPV_SRC" >&2
        echo "[ship]            video playback will fall back to user's system libmpv if installed, else no-op" >&2
    fi
fi

if [[ -n "$ICON_SOURCE" ]]; then
    mkdir -p "$SHARE_DIR/icons" "$SHARE_DIR/applications"
    cp "$ICON_SOURCE" "$SHARE_DIR/icons/$ICON_FILE"
    cat > "$SHARE_DIR/applications/${NAME}.desktop.in" << DESKTOP
[Desktop Entry]
Type=Application
Name=$NAME
Exec=@EXEC@
Icon=@ICON@
Terminal=false
Categories=Development;
DESKTOP
fi

# Walk ldd output, bundle every non-system .so. When the SDK ships a
# matching lib in deps/sysroot/usr/lib (the glibc family + our pins),
# bundle THAT version, not the one ldd resolved from the build host. This
# is what lets a cart built on Whonix (glibc 2.36) still ship our pinned
# SDL3.so.0 — the bundled glibc is from the SDK builder's host (newer),
# so SDL3's GLIBC_2.38 symbol references resolve at runtime.
SR_LIB="$RJIT_HOME/deps/sysroot/usr/lib"
LIB_COUNT=0

# Allowlist of soname stems we OWN — the SDK either pins a specific
# version, vendors the source, or builds the .so itself. Bundled from
# the SDK sysroot (or wherever we built them). Anything ldd reports
# that doesn't match this list stays on the user's system — every
# Linux desktop ships its own libc, libX11, libpulse, libdbus, libcurl
# etc. in its base install. Bundling those was just bloat and made
# our binaries vulnerable to ABI mismatches with the user's loader.
#
# When a user's host genuinely lacks one of the unbundled libs, the
# launcher script (run on first extract) emits a clear error pointing
# at apt/brew/pacman — same probe pattern as tui/examples/reactjit-
# installer.tsx (see the dep scan there for the full UX).
BUNDLE_PREFIXES=(
    "libSDL3"
    "libfreetype"
)
[[ "$WANT_PRIVACY" == "1" ]] && BUNDLE_PREFIXES+=("libsodium")
[[ "$WANT_SQLITE" == "1" ]]  && BUNDLE_PREFIXES+=("libsqlite3")
[[ "$WANT_WHISPER" == "1" ]] && BUNDLE_PREFIXES+=("libwhisper")
[[ "$WANT_EMBED" == "1" ]]   && BUNDLE_PREFIXES+=("libllama_ffi")
# Feature-gated build flags don't all have ship-gate equivalents
# (has-video / has-physics / has-terminal / has-lua-worker / has-midi
# / has-audio). They ride their build flags into the ldd output, so
# any matching soname here picks them up:
BUNDLE_PREFIXES+=("libmpv" "libbox2d" "libvterm" "libluajit" "libllama" "libggml")

soname_matches_allowlist() {
    local sn="$1"
    for prefix in "${BUNDLE_PREFIXES[@]}"; do
        # Match `libfoo.so` or `libfoo.so.<ver>` — but NOT `libfoobar.*`
        case "$sn" in
            "${prefix}.so"|"${prefix}.so."*) return 0 ;;
        esac
    done
    return 1
}

LDD_TMP=$(mktemp)
ldd "$BUILD_BIN" > "$LDD_TMP" 2>/dev/null || true
SKIPPED_SYS=0
while IFS= read -r line; do
    case "$line" in *linux-vdso*) continue ;; esac
    soname=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*=>.*//')
    if ! soname_matches_allowlist "$soname"; then
        SKIPPED_SYS=$((SKIPPED_SYS + 1))
        continue
    fi
    if [[ -f "$SR_LIB/$soname" ]]; then
        real_path=$(readlink -f "$SR_LIB/$soname")
    else
        lib_path=$(echo "$line" | sed -n 's/.* => \([^ ]*\) .*/\1/p')
        [[ -z "$lib_path" || ! -f "$lib_path" ]] && continue
        real_path=$(readlink -f "$lib_path")
    fi
    [[ -f "$LIB_DIR/$soname" ]] && continue
    cp "$real_path" "$LIB_DIR/$soname"
    LIB_COUNT=$((LIB_COUNT + 1))
done < "$LDD_TMP"
rm -f "$LDD_TMP"
echo "[ship]   bundled $LIB_COUNT SDK-owned lib(s); $SKIPPED_SYS system lib(s) skipped (resolved at runtime)"

# Catch-all (opt-in via --fat): copy every .so* from the SDK sysroot lib
# dir into the cart's bundle. Useful on Whonix-class hosts where dlopen
# of libpulsecommon / libpipewire transitive deps fails because the
# pulseaudio runtime dir isn't populated. Default off — every desktop
# Linux ships these in its base install, and the catch-all otherwise
# drags ~30MB of dead .so weight (libluajit, libpipewire, libsndio,
# codec libs, etc.) into every cart binary even when the binary's ldd
# never reports them.
if [[ "$WANT_FAT" == "1" ]] && [[ -d "$SR_LIB" ]]; then
    echo "[ship]   --fat: bundling all sysroot libs (Whonix mode)"
    for so in "$SR_LIB"/*.so*; do
        [[ -e "$so" ]] || continue
        soname=$(basename "$so")
        [[ -e "$LIB_DIR/$soname" ]] && continue
        cp -a "$so" "$LIB_DIR/$soname"
        LIB_COUNT=$((LIB_COUNT + 1))
    done
fi

# ld-linux deliberately NOT bundled. Previously we shipped our own
# ld-linux-x86-64.so.2 and exec'd the binary through it with
# --library-path, on the theory that pinning the loader insulated us
# from glibc ABI mismatches. With the own-libs allowlist (libSDL3 +
# libfreetype + a few feature-gated libs) we no longer bundle libc/glibc
# either, so running the bundled loader against a foreign libc is just
# a confusing extra step. The user's own loader handles everything;
# our launcher just prepends $DIR/lib to LD_LIBRARY_PATH so our pinned
# libs win and falls back to system search for everything else.

# ── Bundle postgres ──────────────────────────────────────────────────
# Carts that touch the PG-backed cart/app/db routes need a postgres
# binary at runtime. We copy the staged `<RJIT_HOME>/.pg-bundle/` into
# `$TMP_DIR/pg/` so framework/pg.zig:findBundleRoot finds it at
# `<exe-dir>/pg/bin/postgres` after extraction. ~22 MB.
#
# Opt-in via the existence of .pg-bundle/. Users who don't need PG just
# don't run scripts/stage-pg-bundle and pay zero size cost. Users on
# fresh clones who DO need it run it once after the first ship.
if [[ -d "$RJIT_HOME/.pg-bundle" ]]; then
    cp -RL "$RJIT_HOME/.pg-bundle" "$TMP_DIR/pg"
    PG_SIZE=$(du -sh "$TMP_DIR/pg" | awk '{print $1}')
    echo "[ship]   bundled postgres ($PG_SIZE) — extract dir → pg/bin/postgres"
fi

# Launcher: use the user's own ld-linux. Prepend $DIR/lib to
# LD_LIBRARY_PATH so our SDK-pinned libs (SDL3, freetype, optional
# feature libs) win over any system copy, but fall back to the system
# loader's normal search for everything we didn't bundle (libc,
# libstdc++, libcurl, libpulse, libX11, libxkbcommon, libdbus, …).
cat > "$TMP_DIR/run" << 'LAUNCHER'
#!/bin/sh
DIR="$(cd "$(dirname "$0")" && pwd)"
export LD_LIBRARY_PATH="$DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$DIR/app.bin" "$@"
LAUNCHER
chmod +x "$TMP_DIR/run"

# Tarball + self-extracting wrapper
TARBALL="/tmp/reactjit-${NAME}-payload.tar.gz"
(cd "$TMP_DIR" && tar czf "$TARBALL" .)

# Write wrapper to a staging file, then atomic-rename over the build output.
# Atomic rename works even if the previous binary is currently running —
# the running process keeps its fd to the old inode, the dentry is replaced.
STAGED="${BUILD_BIN}.staged"
cat > "$STAGED" << HEADER
#!/bin/sh
set -e
APP_DIR=\${XDG_CACHE_HOME:-\$HOME/.cache}/reactjit-$NAME
SIG=\$(md5sum "\$0" 2>/dev/null | cut -c1-8 || cksum "\$0" | cut -d" " -f1)
CACHE="\$APP_DIR/\$SIG"
ICON_FILE="$ICON_FILE"
if [ ! -f "\$CACHE/.ready" ]; then
  rm -rf "\$APP_DIR"
  mkdir -p "\$CACHE"
  SKIP=\$(awk '/^__ARCHIVE__\$/{print NR + 1; exit}' "\$0")
  tail -n+"\$SKIP" "\$0" | tar xz -C "\$CACHE"
  if [ -n "\$ICON_FILE" ] && [ -f "\$CACHE/share/applications/$NAME.desktop.in" ]; then
    sed "s|@EXEC@|\$CACHE/run|g; s|@ICON@|\$CACHE/share/icons/\$ICON_FILE|g" \
      "\$CACHE/share/applications/$NAME.desktop.in" > "\$CACHE/share/applications/$NAME.desktop"
  fi
  touch "\$CACHE/.ready"
fi
exec "\$CACHE/run" "\$@"
__ARCHIVE__
HEADER
cat "$TARBALL" >> "$STAGED"
chmod +x "$STAGED"
mv -f "$STAGED" "$BUILD_BIN"

SIZE_MB=$(du -m "$BUILD_BIN" | cut -f1)
echo "[ship] done (${SIZE_MB}MB self-extracting, $LIB_COUNT libs bundled) → $BUILD_BIN"
rm -rf "$TMP_DIR" "$TARBALL"

# ── 4. Post-build snapshot gate ───────────────────────────────────────
# Runs the binary headless with ZIGOS_WITNESS=snapshot to emit
# tests/<NAME>.autotest and gate on FAIL lines + runtime errors. Disabled
# by default since the V8 migration — opt in with SHIP_RUN_SNAPSHOT=1.
mkdir -p "$CART_ROOT/tests"
AUTOTEST_FILE="$CART_ROOT/tests/${NAME}.autotest"
if [ "${SHIP_RUN_SNAPSHOT:-0}" = "1" ]; then
    SNAP_STDERR=$(mktemp)
    SNAP_T0=$(date +%s%N)
    ZIGOS_HEADLESS=1 ZIGOS_WITNESS=snapshot ZIGOS_WITNESS_FILE="$AUTOTEST_FILE" \
        timeout -s KILL 300 "$BUILD_BIN" >/dev/null 2>"$SNAP_STDERR" || true
    SNAP_T1=$(date +%s%N)
    SNAP_MS=$(( (SNAP_T1 - SNAP_T0) / 1000000 ))

    RUNTIME_ERRORS=$(grep -cE '^error:|^\[luajit-runtime\]|^\[evalExpr error\]|^\[evalToString error\]|^\[evalLuaMapData error\]|^\[js_on_press\].*error|ReferenceError|SyntaxError|TypeError' "$SNAP_STDERR" 2>/dev/null || true)
    RUNTIME_ERRORS=${RUNTIME_ERRORS//[^0-9]/}; RUNTIME_ERRORS=${RUNTIME_ERRORS:-0}
    if [ "$RUNTIME_ERRORS" -gt 0 ]; then
        echo "[$NAME] runtime: ${RUNTIME_ERRORS} error(s) detected" >&2
        grep -E '^error:|^\[luajit-runtime\]|^\[eval.*error\]|^\[evalLuaMapData error\]|ReferenceError|SyntaxError|TypeError' "$SNAP_STDERR" | head -10 >&2
    fi
    grep '^\[snapshot\]' "$SNAP_STDERR" 2>/dev/null || true
    SNAP_LOG_KEEP="$CART_ROOT/tests/screenshots/${NAME}/.last-snapshot.log"
    mkdir -p "$(dirname "$SNAP_LOG_KEEP")"
    cp "$SNAP_STDERR" "$SNAP_LOG_KEEP" 2>/dev/null || true
    rm -f "$SNAP_STDERR"

    EXPECT_COUNT=0; CLICK_COUNT=0; FAIL_COUNT=0
    if [ -f "$AUTOTEST_FILE" ]; then
        EXPECT_COUNT=$(grep -c '^expect ' "$AUTOTEST_FILE" 2>/dev/null || true)
        CLICK_COUNT=$(grep -c '^click ' "$AUTOTEST_FILE" 2>/dev/null || true)
        FAIL_COUNT=$(grep -c '^# FAIL' "$AUTOTEST_FILE" 2>/dev/null || true)
        EXPECT_COUNT=${EXPECT_COUNT//[^0-9]/}; EXPECT_COUNT=${EXPECT_COUNT:-0}
        CLICK_COUNT=${CLICK_COUNT//[^0-9]/}; CLICK_COUNT=${CLICK_COUNT:-0}
        FAIL_COUNT=${FAIL_COUNT//[^0-9]/}; FAIL_COUNT=${FAIL_COUNT:-0}
    else
        echo "[$NAME] snapshot: failed to generate autotest (${SNAP_MS}ms)" >&2
    fi

    TOTAL_FAILS=$(( FAIL_COUNT + RUNTIME_ERRORS ))
    if [ "$TOTAL_FAILS" -gt 0 ]; then
        echo "[$NAME] snapshot: ${EXPECT_COUNT} expects + ${CLICK_COUNT} clicks + ${TOTAL_FAILS} FAILS in ${SNAP_MS}ms → $AUTOTEST_FILE" >&2
        echo "[$NAME] SNAPSHOT FAILED — cleaning up broken binary" >&2
        rm -f "$BUILD_BIN" 2>/dev/null || true
        rm -rf "$CART_ROOT/zig-out/bin/${NAME}.app" 2>/dev/null || true
        exit 1
    fi
    echo "[$NAME] snapshot: ${EXPECT_COUNT} expects + ${CLICK_COUNT} clicks in ${SNAP_MS}ms → $AUTOTEST_FILE"
fi

# ── 5. Post-build autotest replay ─────────────────────────────────────
# Replay the autotest file (must already exist from a prior SHIP_RUN_SNAPSHOT
# run) and produce the proof grid. Disabled by default since the V8 migration
# — opt in with SHIP_RUN_AUTOTEST=1.
