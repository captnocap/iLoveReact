#!/bin/sh
# scripts/tui — bundle a cart through tui/entry.tsx and run it as a real
# TUI host binary (every optional binding linked in).
#
# Usage:  scripts/tui [<entry.tsx>] [-- script-args...]
#         (default: tui/examples/counter.tsx)
#
# Pipeline:
#   1. esbuild → tui/.cache/bundle-<name>.js   (TUI entry + cart aliased in)
#   2. zig build tui-app -Dapp-name=<name> -Dbundle-path=<bundle>
#      with EVERY tui-app `-Dhas-*` flag forced on → zig-out/bin/<name>
#   3. exec the binary.
#
# Why every flag is forced on: same philosophy as scripts/dev for the GPU
# host. In dev we want any hook the cart imports (or might import after
# a hot edit) to "just work" without re-bundling to re-run the metafile
# gate. The metafile gate is correct for ship-tui (one cart, one
# binary, link only what's needed); for the dev iterate path it's a
# foot-gun — gallery.tsx imports useAssistant via require(), nothing
# triggers the sdk gate, and the resulting binary silently lacks the
# bindings useAssistant needs. So: dev = everything on, ship = gated.
#
# Why not tools/v8cli at all: v8cli only registers framework/v8_bindings_cli.zig
# (fs, process for the build scripts). No __vterm_spawn, no worker_*,
# no net, no sdk. Any cart that mounts <Terminal> or calls useAssistant
# falls through the stub branch in tui/host.ts or the hasHost()=false
# branch in the hook.

set -e
cd "$(dirname "$0")/.."
ROOT="$PWD"
ENTRY="${1:-tui/examples/counter.tsx}"
shift 2>/dev/null || true
ESBUILD="$ROOT/tools/esbuild"
V8CLI="$ROOT/tools/v8cli"
[ -x "$ROOT/zig-out/bin/v8cli" ] && [ "$ROOT/zig-out/bin/v8cli" -nt "$V8CLI" ] && V8CLI="$ROOT/zig-out/bin/v8cli"
ZIG="${REACTJIT_ZIG:-$ROOT/tools/zig/zig}"
[ -x "$ZIG" ] || ZIG=zig

case "$ENTRY" in
  /*) ENTRY_ABS="$ENTRY" ;;
  *)  ENTRY_ABS="$ROOT/$ENTRY" ;;
esac
[ -f "$ENTRY_ABS" ] || { echo "[tui] missing entry: $ENTRY" >&2; exit 2; }

# react / react-reconciler / scheduler materialized from deps/. Bun
# followed symlinks into deps/ and couldn't resolve nested requires,
# so we copy (one-time, ~1.6MB; gitignored).
NM="$ROOT/tui/node_modules"
if [ ! -d "$NM/react-reconciler/cjs" ]; then
  mkdir -p "$NM"
  for pkg in react react-reconciler scheduler loose-envify js-tokens; do
    [ -d "$NM/$pkg" ] || cp -RL "$ROOT/deps/$pkg" "$NM/$pkg"
  done
fi

# Terminal size baked into the bundle as compile-time constants. The
# JS preamble re-reads it at boot via __termSize, but esbuild still
# wants concrete define values.
SIZE=$(stty size 2>/dev/null || echo "24 80")
ROWS=$(echo "$SIZE" | cut -d' ' -f1)
COLS=$(echo "$SIZE" | cut -d' ' -f2)

NAME=$(basename "$ENTRY_ABS" .tsx)
OUT="$ROOT/tui/.cache/bundle-$NAME.js"
mkdir -p "$ROOT/tui/.cache"

"$ESBUILD" \
  --bundle "$ROOT/tui/entry.tsx" \
  --outfile="$OUT" \
  --metafile="$OUT.metafile.json" \
  --platform=neutral \
  --main-fields=module,main \
  --target=es2020 \
  --jsx=automatic \
  --jsx-import-source=react \
  --format=cjs \
  --define:process.env.NODE_ENV='"production"' \
  --define:__TUI_COLS__=$COLS \
  --define:__TUI_ROWS__=$ROWS \
  --log-level=warning \
  --resolve-extensions=.tsx,.ts,.jsx,.js \
  --conditions=default \
  --alias:@cart-entry="$ENTRY_ABS" \
  --alias:@reactjit/core="$ROOT/runtime/core_stub.ts" \
  --alias:@reactjit/runtime="$ROOT/runtime" \
  --alias:react="$ROOT/deps/react" \
  --alias:react-reconciler="$ROOT/deps/react-reconciler" \
  --alias:scheduler="$ROOT/deps/scheduler" \
  --alias:loose-envify="$ROOT/deps/loose-envify" \
  --alias:js-tokens="$ROOT/deps/js-tokens"

# Dev mode: turn on every `-Dhas-*` flag tui-app declares. This list
# tracks v8_tui_app.zig's `HAS_*` checks (and build.zig's tui_options
# block). When v8_tui_app gains another optional binding, add the flag
# here. ship-tui gates these by metafile; scripts/tui doesn't.
DEV_TUI_FLAGS="-Dhas-terminal=true -Dhas-httpsrv=true -Dhas-wssrv=true -Dhas-process=true -Dhas-net=true -Dhas-sdk=true -Dhas-fs=true"

echo "[tui] zig build app -Dhas-gpu=false -Dapp-name=$NAME $DEV_TUI_FLAGS"
# shellcheck disable=SC2086
"$ZIG" build app \
  -Doptimize=ReleaseFast \
  -Dhas-gpu=false \
  -Dapp-name="$NAME" \
  -Dbundle-path="$OUT" \
  $DEV_TUI_FLAGS

OUT_BIN="$ROOT/zig-out/bin/$NAME"
[ -x "$OUT_BIN" ] || { echo "[tui] build did not produce $OUT_BIN" >&2; exit 1; }

exec "$OUT_BIN" "$@"
