#!/bin/sh
# fetch-pose-models — vendor the pose-estimation ONNX models the editor's
# animation capture uses. Same home as the SlimSAM pair: ~/.reactjit/models/.
#
# BlazePose GHUM full (req_4387, framework/ml/blazepose.zig) — the capture
# lane. Two graphs, parity-proven ONNX conversions of Google MediaPipe's
# Apache-2.0 pose_landmarker_full task bundle (worst-case world-landmark
# delta 1.02 cm vs the Python mediapipe reference; contract + provenance:
# https://github.com/fernandotonon/QtMeshEditor/blob/master/docs/MOCAP_SPIKE.md):
#   blazepose_detector.onnx   input f32[1,224,224,3] in [-1,1]
#                             → [1,2254,12] boxes+keypoints, [1,2254,1] scores
#   blazepose_landmarks.onnx  input f32[1,256,256,3] in [0,1]
#                             → [1,195] screen landmarks, [1,1] presence,
#                               [1,117] WORLD landmarks (metres, hip-centred)
set -e
DIR="$HOME/.reactjit/models"
mkdir -p "$DIR"

fetch() {
  out="$DIR/$1"
  url="$2"
  if [ -s "$out" ]; then
    echo "[pose-models] already present: $out ($(du -h "$out" | cut -f1))"
    return 0
  fi
  echo "[pose-models] downloading $1 → $out"
  curl -fsSL -o "$out" "$url"
  echo "[pose-models] done: $(du -h "$out" | cut -f1)"
}

fetch blazepose_detector.onnx "https://huggingface.co/fernandotonon/QtMeshEditor-blazepose-onnx/resolve/main/pose_detector.onnx"
fetch blazepose_landmarks.onnx "https://huggingface.co/fernandotonon/QtMeshEditor-poselandmarks-onnx/resolve/main/pose_landmarks.onnx"
