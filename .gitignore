# Workspace-cart session scratch — per-cart autosaved working state (cutout,
# hmsc-int, ...). Runtime "disk = truth" state, written every few hundred ms
# while editing; never commit it, and keep file-trail watchers from churning on it.
cart/*/sessions/

# World Bible conditional-write artifacts. Confirmed pages are the direct
# `*.md` children; prepared temps, stable transaction locks, and versioned
# prior inodes stay local for crash/racing-editor recovery and must never enter
# the shipped corpus.
world/knowledge/*.md.tmp.*
world/knowledge/*.md.write-lock
world/knowledge/*.md.write-pending

# hmsc-int persistence content — runtime authoring state, never git's (the
# layer code in cart/hmsc-int/data/*.ts and the umbrella manifest are tracked).
# The live backing is cart/hmsc-int/data/domains/<domain>/store.db (sqlite,
# already caught by the *.db/*.db-wal/*.db-shm patterns above). Legacy root
# streams/snapshots are ignored while old worktrees drain.
cart/hmsc-int/data/streams/
cart/hmsc-int/data/snapshots/
cart/hmsc-int/data/domains/*/streams/
cart/hmsc-int/data/domains/*/snapshots/
# Compact-store safety backups (rjit game compact-store, req_1789) — the stale
# pre-compaction copies (e.g. _precompact_backup/model.store.db.bak, ~700MB);
# kept on disk as a recovery net, never git's. Matches at any depth under data/.
cart/hmsc-int/data/**/_precompact_backup/
cart/hmsc-int/data/**/_compact_backup/
# Editor-baked decal pixel files (DECALPIXFILE-0610) — derived cache the
# DecalPixelBaker regenerates from the stored DecalDocs; never git's.
cart/hmsc-int/data/decal-pixels/

