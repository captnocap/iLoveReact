#!/usr/bin/env bash
# genmodel — root-level shim. The real script lives next to the hmsc-int prop
# importer it feeds (cart/hmsc-int/tools/genmodel); this lets you run the short
# `tools/genmodel ...` from the repo root like rjit/v8cli.
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/cart/hmsc-int/tools/genmodel" "$@"
