#!/usr/bin/env bash
# retopo-corpus bundler (req_4592) — capture each hand-retopo session as a training
# triple: source draft + edit trail (the seat's follow firehose) + final package.
# The corpus lives in userdata/ (SIBLING of zig-out — no build cleanup reaches it).
#
#   tools/forge/corpus begin  <name> <source-mesh-file>   # start recording, file the source
#   tools/forge/corpus finish <name> <package-dir>        # trail -> disk, bundle the final
#   tools/forge/corpus list                               # inventory
set -euo pipefail
cd "$(dirname "$0")/../.."
ROOT=userdata/retopo-corpus

# The host journal is a 32-op undo WINDOW and the follow trail lives in host
# MEMORY (req_4602/4605) — so the poller drains BOTH to disk every 20s. Closing
# the app then never loses more than the last poll interval; while the app is
# down the seat calls fail silently and resume when it returns.
spawn_poller() {
  local dir=$1
  nohup bash -c "while :; do
    tools/seat action history-log '{}' >> '$dir/journal-samples.jsonl' 2>/dev/null
    tools/seat follow read >> '$dir/trail-samples.jsonl' 2>/dev/null
    sleep 20
  done" >/dev/null 2>&1 &
  echo $! > "$dir/.poller.pid"
}

cmd=${1:?usage: corpus begin|resume|finish|list}
case "$cmd" in
  begin)
    name=${2:?corpus begin <name> [source-mesh-file]}
    src=${3:-}
    dir="$ROOT/$name"
    mkdir -p "$dir/source"
    # Source is optional: every saved package carries its own import copy in
    # mesh/, so a UI-started recording can rely on finish's package bundle.
    if [ -n "$src" ]; then cp "$src" "$dir/source/"; fi
    tools/seat follow clear >/dev/null 2>&1 || true
    tools/seat follow start "corpus-$name" >/dev/null
    spawn_poller "$dir"
    date -u +%FT%TZ > "$dir/begun.txt"
    echo "recording '$name' (source: $(basename "$src")) — retopo away."
    echo "when done: tools/forge/corpus finish $name <package-dir>"
    ;;
  resume)
    # Re-arm an unfinished entry after an app or machine restart: fresh follow
    # session (same label — earlier events are already drained to trail-samples),
    # poller respawned only if its pid is dead. The dock's REC light calls this
    # on boot so a relit light always means an armed recorder.
    name=${2:?corpus resume <name>}
    dir="$ROOT/$name"
    [ -d "$dir" ] || { echo "no corpus entry '$name'"; exit 1; }
    [ -f "$dir/finished.txt" ] && { echo "'$name' is already finished"; exit 1; }
    tools/seat follow start "corpus-$name" >/dev/null 2>&1 || true
    if [ -f "$dir/.poller.pid" ] && kill -0 "$(cat "$dir/.poller.pid")" 2>/dev/null; then
      echo "resumed '$name' (poller already running)"
    else
      spawn_poller "$dir"
      echo "resumed '$name' (poller respawned)"
    fi
    ;;
  finish)
    name=${2:?corpus finish <name> [package-dir]}
    pkg=${3:-}
    dir="$ROOT/$name"
    [ -d "$dir" ] || { echo "no corpus entry '$name' — run begin first"; exit 1; }
    if [ -f "$dir/.poller.pid" ]; then
      kill "$(cat "$dir/.poller.pid")" 2>/dev/null || true
      rm -f "$dir/.poller.pid"
    fi
    tools/seat action history-log '{}' >> "$dir/journal-samples.jsonl" 2>/dev/null || true
    if ! tools/seat follow read > "$dir/trail.json" 2>/dev/null; then
      echo "WARN: edit trail read failed — bundle continues with source+final only"
      rm -f "$dir/trail.json"
    fi
    tools/seat follow stop >/dev/null 2>&1 || true
    if [ -n "$pkg" ] && [ -d "$pkg" ]; then
      rm -rf "$dir/final"
      cp -r "$pkg" "$dir/final"
    else
      echo "WARN: no package dir — bundle has trail+journal only; copy the saved package into $dir/final later"
    fi
    date -u +%FT%TZ > "$dir/finished.txt"
    echo "bundled $dir:"
    ls "$dir"
    ;;
  list)
    [ -d "$ROOT" ] || { echo "corpus empty ($ROOT)"; exit 0; }
    total=0
    for entry in "$ROOT"/*/; do
      [ -d "$entry" ] || continue
      total=$((total + 1))
      state="RECORDING"
      [ -f "$entry/finished.txt" ] && state="done $(cat "$entry/finished.txt")"
      trail="no-trail"
      [ -f "$entry/trail.json" ] && trail="trail:$(du -h "$entry/trail.json" | cut -f1)"
      [ -f "$entry/trail-samples.jsonl" ] && trail="$trail+$(wc -l < "$entry/trail-samples.jsonl")drain"
      journal="no-journal"
      [ -f "$entry/journal-samples.jsonl" ] && journal="journal:$(wc -l < "$entry/journal-samples.jsonl")smp"
      echo "$(basename "$entry")  $state  $trail  $journal"
    done
    echo "-- $total entries"
    ;;
  *)
    echo "usage: corpus begin <name> <source-mesh-file> | finish <name> <package-dir> | list"
    exit 1
    ;;
esac
