#!/usr/bin/env node
// Shell adapter for cart/editor/agent/seatApi.ts. It sends one bounded NOTICE to
// the running live editor and waits for that request's exact /tmp reply file.
const fs = require('fs');
const net = require('net');
const path = require('path');
const { parseFaceTableArgs, faceTablePendingReceipt } = require('./seat_args');

const args = process.argv.slice(2);
const briefIndex = args.indexOf('--brief');
const brief = briefIndex >= 0;
if (brief) args.splice(briefIndex, 1);
// --wait <seconds> and --fields <dotted,paths> (req_4052). Both exist because the
// transcripts showed agents papering over their absence: `python3 -c "time.sleep(4)"`
// before a call that might race the editor's boot, and `| jq '{ok,reason,result}'` on
// a reply whose default shape answered more than the question did.
const takeOption = (flag) => {
  const at = args.indexOf(flag);
  if (at < 0) return null;
  const value = args[at + 1];
  args.splice(at, value === undefined ? 1 : 2);
  return value ?? null;
};
let waitSeconds = Number(takeOption('--wait') ?? 0);
const fields = (takeOption('--fields') ?? '').split(',').map((name) => name.trim()).filter(Boolean);
if (args.indexOf('--wait') >= 0 || args.indexOf('--fields') >= 0) {
  console.error('seat: --wait and --fields each take one value, and must precede the action');
  process.exit(2);
}
const action = args.shift() || 'look';
const numberList = (values) => values.map((value) => Number(value));
let request;
if (action === 'face-table') {
  try {
    const parsed = parseFaceTableArgs(args);
    request = { action, args: parsed.request };
    waitSeconds = parsed.waitMs / 1000;
  } catch (error) {
    console.error(`seat: ${error.message}`);
    process.exit(2);
  }
}
else if (['look', 'semantic-status', 'rig-status', 'elements', 'undo', 'redo', 'connect', 'delete', 'merge-faces', 'weld', 'flip', 'glass', 'save', 'tris-to-quads', 'collect-uv-orientation'].includes(action)) request = { action };
else if (action === 'follow') {
  const operation = args.shift() || 'read';
  if (operation === 'inspect') {
    const faces = String(args[0] || '').split(',').filter(Boolean).map(Number);
    request = { action, args: { operation, ...(faces.length ? { faces } : {}), rings: Number(args[1] || 2) } };
  } else request = { action, args: {
    operation,
    ...(operation === 'start' ? { label: args.join(' ') } : {}),
    ...((operation === 'read' || operation === 'stop') && args.length ? {
      offset: Number(args[0] || 0), limit: Number(args[1] || 8),
    } : {}),
  } };
}
// package <info|regions|diff> [model-id] — read what the last SAVE actually wrote,
// with the editor's own RJMD decoder. Never parse mesh/doc.blob by hand: the header
// grew 40 → 48 bytes at RJMD v5 and a hand reader just returns wrong numbers.
// package <info|regions|ranges|diff> [model] · package triangles <lo> [count] | <a,b,c>
// · package compare <otherModel> — all read through the editor's own RJMD decoder.
else if (action === 'package') {
  const operation = args.shift() || 'info';
  if (operation === 'triangles') {
    const head = String(args[0] ?? '0');
    request = { action, args: head.includes(',')
      ? { operation, indices: head.split(',').map(Number) }
      : { operation, lo: Number(head), limit: Number(args[1] || 16) } };
  } else if (operation === 'compare') {
    request = { action, args: { operation, other: args[0], ...(args[1] ? { tolerance: Number(args[1]) } : {}) } };
  } else request = { action, args: { operation, ...(args[0] ? { model: args[0] } : {}) } };
}
// measure <bbox <target> | distance <a> <b> | contact <a> <b>> — the editor does the
// arithmetic. Targets are any selector, plus `selection` and `model`.
else if (action === 'measure') {
  const operation = args.shift() || 'bbox';
  request = { action, args: operation === 'bbox'
    ? { operation, target: args.join(' ') }
    : { operation, a: args[0], b: args[1] } };
}
// stats <edges [target] | symmetry <axis> | anomalies [target]>
else if (action === 'stats') {
  const operation = args.shift() || 'anomalies';
  request = { action, args: operation === 'symmetry'
    ? { operation, axis: args[0] || 'x' }
    : { operation, ...(args.length ? { target: args.join(' ') } : {}) } };
}
// align <moving> onto <target> [axis] [--dry-run] — computes the seating delta and
// applies it as one transaction, so the number reported is the number that moved.
else if (action === 'align') {
  const dryIndex = args.indexOf('--dry-run');
  const dryRun = dryIndex >= 0;
  if (dryRun) args.splice(dryIndex, 1);
  const ontoIndex = args.indexOf('onto');
  if (ontoIndex < 0) { console.error('seat align expects: align <moving> onto <target> [axis] [--dry-run]'); process.exit(2); }
  const moving = args.slice(0, ontoIndex).join(' ');
  const rest = args.slice(ontoIndex + 1);
  const axis = ['x', 'y', 'z'].includes(rest[rest.length - 1]) ? rest.pop() : undefined;
  request = { action, args: { moving, onto: rest.join(' '), ...(axis ? { axis } : {}), ...(dryRun ? { dryRun: true } : {}) } };
}
// oracle <start "<task>" | status [--doc] | advance | attest <id> "<note>" | ask "<query>" | plans>
// The phase-gate router: it classifies the task, serves only the doc slices that task
// needs, and refuses to advance past a phase whose exit criteria are unmet.
else if (action === 'oracle') {
  const operation = args.shift() || 'status';
  if (operation === 'start') request = { action, args: { operation, task: args.join(' ') } };
  else if (operation === 'ask') request = { action, args: { operation, query: args.join(' ') } };
  else if (operation === 'attest') request = { action, args: { operation, id: args.shift(), note: args.join(' ') } };
  // note [decision|observation|todo] "<text>" | note read | note drop <id> | note clear
  else if (operation === 'note') {
    const kinds = ['decision', 'observation', 'todo'];
    const verbs = ['read', 'drop', 'clear'];
    const head = args[0];
    if (verbs.includes(head)) request = { action, args: { operation, note: args.shift(), ...(args.length ? { id: Number(args[0]) } : {}) } };
    else {
      const kind = kinds.includes(head) ? args.shift() : 'observation';
      request = { action, args: { operation, note: 'append', kind, text: args.join(' '), ...(process.env.RJIT_SEAT_AGENT ? { agent: process.env.RJIT_SEAT_AGENT } : {}) } };
    }
  }
  else if (operation === 'spec') request = { action, args: { operation, ...(args[0] ? { class: args[0] } : {}) } };
  // exemplar <class> <model> --by <who> [--reject "<reason>"] — a PERSON's verdict.
  else if (operation === 'exemplar') {
    const take = (flag) => { const at = args.indexOf(flag); if (at < 0) return null; const value = args[at + 1]; args.splice(at, value === undefined ? 1 : 2); return value ?? null; };
    const by = take('--by');
    const reject = take('--reject');
    request = { action, args: {
      operation, class: args[0], model: args[1], by,
      ...(reject === null ? {} : { verdict: 'rejected', reason: reject }),
    } };
  }
  else if (operation === 'telemetry') request = { action, args: { operation } };
  else if (operation === 'status') {
    const docIndex = args.indexOf('--doc');
    if (docIndex >= 0) args.splice(docIndex, 1);
    request = { action, args: { operation, ...(docIndex >= 0 ? { doc: true } : {}) } };
  } else request = { action, args: { operation } };
}
// Intent amplifiers (req_4061): two decisions expand to N elements. Every one PREVIEWS
// by default — the reply says what it computed, why the walk stopped, and how ties
// broke — and only commits when you pass --apply.
//   select-path <fromVert> <toVert> [axis] [--apply] [+]
//   select-loop|select-ring <edge> [--apply] [+]
//   select-grow [rings] [--apply] [+]
//   select-similar <face> [normal|coplanar|area] [tolerance] [--apply] [+]
else if (['select-path', 'select-loop', 'select-ring', 'select-grow', 'select-similar'].includes(action)) {
  const applyIndex = args.indexOf('--apply');
  const apply = applyIndex >= 0;
  if (apply) args.splice(applyIndex, 1);
  const plusIndex = args.indexOf('+');
  const additive = plusIndex >= 0;
  if (additive) args.splice(plusIndex, 1);
  const extra = { ...(apply ? { apply: true } : {}), ...(additive ? { additive: true } : {}) };
  if (action === 'select-path') request = { action, args: { from: Number(args[0]), to: Number(args[1]), ...(args[2] ? { axis: args[2] } : {}), ...extra } };
  else if (action === 'select-grow') request = { action, args: { rings: Number(args[0] || 1), ...extra } };
  else if (action === 'select-similar') request = { action, args: { face: Number(args[0]), ...(args[1] ? { by: args[1] } : {}), ...(args[2] ? { tolerance: Number(args[2]) } : {}), ...extra } };
  else request = { action, args: { edge: Number(args[0]), ...extra } };
}
// regions [filter] [--all] — the semantic table JOINED to its geometry: name, role,
// parent, faces, bbox, size. One read instead of joining two arrays from `look`.
else if (action === 'regions') {
  const allIndex = args.indexOf('--all');
  const all = allIndex >= 0;
  if (all) args.splice(allIndex, 1);
  request = { action, args: { ...(args.length ? { filter: args.join(' ') } : {}), ...(all ? { all: true } : {}) } };
}
// set-position <axis> <value> — absolute placement. Agents think in target coordinates
// ("tabletop at 0.75 m"); without this every one becomes read-bbox, subtract, move.
else if (action === 'set-position') request = { action, args: { axis: args[0], value: Number(args[1]), ...(args[2] ? { anchor: args[2] } : {}) } };
// for-each <selector> <action> [json-args] — one decision applied per matching part.
else if (action === 'for-each') {
  const selector = args.shift();
  const inner = args.shift();
  let innerArgs = {};
  if (args.length) { try { innerArgs = JSON.parse(args.join(' ')); } catch { console.error('seat for-each expects a JSON object after the action name'); process.exit(2); } }
  request = { action, args: { selector, do: { action: inner, args: innerArgs } } };
}
// wait-ready [seconds] — block until the shell answers healthy. The sanctioned
// replacement for sleeping a guessed number of seconds before the first real call.
else if (action === 'wait-ready') request = { action: 'editor-status', args: {} };
else if (action === 'select') request = { action, args: { selector: args.join(' ') } };
else if (action === 'select-edge' || action === 'select-vertex' || action === 'select-face') request = { action, args: { index: Number(args[0]), additive: args[1] === '+' } };
else if (action === 'name') request = { action, args: { name: args[0], instance: Number(args[1] || 0) } };
else if (action === 'extrude') request = { action, args: { distance: Number(args[0] || 0), name: args[1], instance: Number(args[2] || 0) } };
else if (action === 'extrude-edge') request = { action, args: { distance: Number(args[0] || 0) } };
else if (action === 'create-face') request = { action, args: { name: args[0], instance: Number(args[1] || 0) } };
else if (action === 'bevel') request = { action, args: { width: Number(args[0] || 0) } };
else if (action === 'inset') request = { action, args: {
  distance: Number(args[0] || 0.001), name: args[1], pivot: numberList(args.slice(2, 5)),
  axes: [numberList(args.slice(5, 8)), numberList(args.slice(9, 12))],
  factors: [Number(args[8]), Number(args[12])],
  ...(args.length >= 16 ? { offset: numberList(args.slice(13, 16)) } : {}),
} };
else if (action === 'move') request = { action, args: { delta: numberList(args.slice(0, 3)) } };
else if (action === 'scale') request = { action, args: { axis: numberList(args.slice(0, 3)), pivot: numberList(args.slice(3, 6)), factor: Number(args[6] || 1) } };
else if (action === 'scale-uniform') request = { action, args: { factor: Number(args[0] || 1) } };
else if (action === 'rotate') request = { action, args: { axis: numberList(args.slice(0, 3)), pivot: numberList(args.slice(3, 6)), degrees: Number(args[6] || 0) } };
// mirror x|y|z [-]  — symmetrize across the axis plane, keeping +side unless '-' is given.
else if (action === 'mirror') request = { action, args: { axis: 'xyz'.indexOf(String(args[0] || 'x').toLowerCase()), keep: String(args[1] || '+') !== '-' } };
// cut <direction 0|1> <cuts> [offsetFraction] — loop cut the current face selection.
else if (action === 'cut') request = { action, args: { direction: Number(args[0] || 0), cuts: Number(args[1] || 1), offset: args[2] === undefined ? 0.5 : Number(args[2]) } };
else if (action === 'basic-cut') request = { action, args: { direction: Number(args[0] || 0), cuts: Number(args[1] || 1), offset: args[2] === undefined ? 0.5 : Number(args[2]) } };
else if (action === 'solidify') request = { action, args: { thickness: Number(args[0] || 0) } };
else if (action === 'detach') request = { action, args: { name: args[0] } };
else if (action === 'paint') request = { action, args: { rgb: numberList(args.slice(0, 3)) } };
// atlas <template|solid|blank> [r g b] [fit] — `fit` is the atlas BUDGET (512|1024|2048|4096),
// not a density; omitted, the seat rebuilds at the painter's default 1024². Raw texels/meter
// stays reachable as `tools/seat action atlas '{"base":"solid","detail":N}'` for the rare case
// that wants an exact density instead of a budget.
else if (action === 'atlas') request = { action, args: {
  base: args[0] || 'template', rgb: args.length >= 4 ? numberList(args.slice(1, 4)) : [220, 220, 225],
  ...(args[4] === undefined ? {} : { fit: Number(args[4]) }),
} };
else if (action === 'material') request = { action, args: { slot: args[0] === 'clear' ? null : Number(args[0]) } };
else if (action === 'uv') request = { action, args: { operation: args[0] } };
// add <kind> <size> <height> <sides> <name> [x y z] — dimensions in METERS (R4).
else if (action === 'add') {
  request = { action, args: {
    kind: args[0], size: Number(args[1] || 0.25), height: Number(args[2] || 0.25),
    sides: Number(args[3] || 16), name: args[4],
    ...(args.length >= 8 ? { at: numberList(args.slice(5, 8)) } : {}),
  } };
} else if (action === 'new') {
  request = { action, args: {
    kind: args[0] || 'cube', size: Number(args[1] || 1), height: Number(args[2] || 1),
    sides: Number(args[3] || 16),
  } };
} else if (action === 'shot') request = { action, args: { path: args[0] } };
else if (action === 'recipes') request = { action: 'recipe-list' };
else if (action === 'recipe') {
  const name = args.shift();
  if (!name) { console.error('seat recipe expects a recipe name and JSON object'); process.exit(2); }
  try { request = { action: 'recipe', args: { recipe: name, params: args.length ? JSON.parse(args.join(' ')) : {} } }; }
  catch { console.error('seat recipe expects a JSON object after the recipe name'); process.exit(2); }
}
// claim <password> [agent] / dismiss <password> / claims — the model lock
// (req_3850). Password falls back to RJIT_SEAT_TOKEN so an agent exports it
// once and every later request authenticates automatically via the payload.
else if (action === 'claim') request = { action, args: {
  password: args[0] || process.env.RJIT_SEAT_TOKEN,
  agent: args[1] || process.env.RJIT_SEAT_AGENT || 'agent',
} };
else if (action === 'dismiss') request = { action, args: { password: args[0] || process.env.RJIT_SEAT_TOKEN } };
else if (action === 'claims') request = { action };
else if (action === 'command') request = { action, args: { id: args[0] } };
// Escape hatch for the structured parity surface. This is deliberately one
// action + one JSON object, not a second SDK: every row still resolves inside
// the resident editor through seatApi's allowlist and existing authorities.
else if (action === 'action') {
  const name = args.shift();
  if (!name) { console.error('seat action expects an action name and optional JSON object'); process.exit(2); }
  try { request = { action: name, args: args.length ? JSON.parse(args.join(' ')) : {} }; }
  catch { console.error('seat action expects a JSON object after the action name'); process.exit(2); }
}
else if (action === 'do') {
  try { request = { action: 'batch', args: { requests: JSON.parse(args.join(' ')) } }; }
  catch { console.error('seat do expects a JSON array of {action,args} rows'); process.exit(2); }
} else {
  console.error('usage: tools/seat [--brief] look|semantic-status|rig-status|face-table [--source resident|saved|preview|diff] [--sort column[:asc|desc]] [--filter kind] [--limit n]|new <kind> [size height sides]|elements|follow <start [label]|read|stop|clear|inspect [faceCsv] [rings]>|select <selector>|select-face|select-edge|select-vertex <id> [+]|name <name> [instance]|extrude <distance> <name>|extrude-edge <distance>|connect|create-face <name>|bevel <width>|inset ...|move x y z|scale ...|rotate ...|mirror x|y|z [-]|cut|basic-cut <dir> <cuts> [offset]|tris-to-quads|collect-uv-orientation|delete|merge-faces|weld|solidify <thickness>|detach <name>|flip|glass|paint r g b|atlas ...|material <slot|clear>|uv <restore|auto-size|project-view>|save|add ...|shot <path>|recipes|recipe <name> <json-object>|claim <password> [agent]|dismiss [password]|claims|command <editor-command-id>|action <seat-action> <json-object>|undo|redo|do <json-array>|package <info|regions|ranges|diff> [model]|package triangles <lo> [n]|<a,b,c>|package compare <model>|measure <bbox <target>|distance <a> <b>|contact <a> <b>>|stats <edges [target]|boundary|symmetry <axis>|anomalies [target]>|align <moving> onto <target> [axis] [--dry-run]|select-path <a> <b> [axis]|select-loop|select-ring <edge>|select-grow [rings]|select-similar <face> [by] [tol]  (all preview; add --apply [+])|regions [filter] [--all]|set-position <axis> <value> [min|center|max]|for-each <selector> <action> [json]|wait-ready [seconds]|oracle <start "<task>"|status [--doc]|advance|attest <id> "<note>"|note [kind] "<text>"|ask "<query>"|spec [class]|exemplar <class> <model> --by <who> [--reject "<why>"]|telemetry|stop|plans>  (global: --brief, --wait <seconds>, --fields <a,b.c>)');
  process.exit(2);
}


// `wait-ready` is a poll by definition; give it a real default instead of making
// every caller remember to pass --wait.
if (action === 'wait-ready') waitSeconds = Number(args[0]) > 0 ? Number(args[0]) : 20;

/** Project a reply down to the fields actually asked for. Dotted paths index into
 *  objects and arrays alike, so `result.frontier` or `percept.regions.0.bbox` both
 *  work — this is the `| jq` the transcripts kept reaching for, minus the dependency
 *  and the shell-quoting hazards. */
const projectFields = (value, paths) => {
  const pick = (root, path) => path.split('.').reduce(
    (node, key) => (node === null || node === undefined ? undefined : node[key]),
    root,
  );
  const out = {};
  for (const path of paths) out[path] = pick(value, path);
  return out;
};

const REPLY_TIMEOUT_MS = 15000;
const RETRY_DELAY_MS = 250;

/** True when a reply means "the editor is not ready yet", as opposed to "the editor
 *  answered and the answer is no". Only the former is worth waiting through: retrying
 *  a rejected extrude forever would just hide the rejection. */
const notReadyYet = (reply) => {
  if (!reply) return false;
  // The explicit word wins over ok/not-ok, because editor-status answers `ok` with a
  // full percept even while a modal is blocking every other verb — reading the state
  // is how a caller learns that waiting is the right move.
  const state = reply.result && typeof reply.result === 'object' ? reply.result.state : null;
  if (state === 'starting' || state === 'dialog-blocked') return true;
  if (faceTablePendingReceipt(reply)) return true;
  if (reply.ok) return false;
  return typeof reply.reason === 'string' && /no live model|not ready|still starting|shell bridge is unavailable/i.test(reply.reason);
};

const sendOnce = () => new Promise((resolve) => {
  const id = `${process.pid}-${Date.now()}-${Math.random().toString(16).slice(2)}`;
  const replyPath = `/tmp/reactjit-seat-${id}.json`;
  const payload = JSON.stringify({
    kind: 'agent-seat', id, replyPath, request, brief,
    ...(process.env.RJIT_SEAT_GENERATION ? { generation: Number(process.env.RJIT_SEAT_GENERATION) } : {}),
    // Claim credentials (req_3850): stamped payload-level so batches carry them
    // once; the shell copies them onto every row.
    ...(process.env.RJIT_SEAT_TOKEN ? { token: process.env.RJIT_SEAT_TOKEN } : {}),
    ...(process.env.RJIT_SEAT_MODEL ? { model: process.env.RJIT_SEAT_MODEL } : {}),
  });
  const socketPath = process.env.RJIT_SOCKET || '/tmp/reactjit.sock';
  const socket = net.createConnection(socketPath);
  socket.setEncoding('utf8');
  let ack = '';
  let settled = false;
  const done = (outcome) => { if (!settled) { settled = true; resolve(outcome); } };
  socket.on('connect', () => socket.write(`NOTICE ${Buffer.byteLength(payload)}\n${payload}`));
  socket.on('data', (chunk) => { ack += chunk; });
  socket.on('error', (error) => done({ kind: 'transport', message: error.message }));
  socket.on('close', () => {
    if (!ack.startsWith('OK')) return done({ kind: 'transport', message: `editor refused request: ${ack.trim()}` });
    const started = Date.now();
    const poll = () => {
      if (fs.existsSync(replyPath)) {
        const text = fs.readFileSync(replyPath, 'utf8');
        try { fs.unlinkSync(replyPath); } catch {}
        try { return done({ kind: 'reply', reply: JSON.parse(text), text }); }
        catch { return done({ kind: 'malformed', message: `unparseable reply in ${path.basename(replyPath)}` }); }
      }
      if (Date.now() - started > REPLY_TIMEOUT_MS) {
        return done({ kind: 'transport', message: `timed out waiting for ${path.basename(replyPath)}` });
      }
      setTimeout(poll, 25);
    };
    poll();
  });
});

const emit = (outcome) => {
  const { reply, text } = outcome;
  if (fields.length > 0) {
    process.stdout.write(`${JSON.stringify(projectFields(reply, fields))}\n`);
  } else if (!brief) {
    process.stdout.write(`${text}\n`);
  } else {
    const rows = reply.op === 'batch' && Array.isArray(reply.result) ? reply.result : [reply];
    for (const row of rows) {
      if (!row || typeof row !== 'object') continue;
      const summary = { ok: row.ok, op: row.op, ...(row.result === undefined ? {} : { result: row.result }), ...(row.reason ? { reason: row.reason } : {}) };
      process.stdout.write(`${JSON.stringify(summary)}\n`);
    }
    process.stdout.write(`${reply.brief || 'no live mesh'}\n`);
  }
  process.exit(reply.ok ? 0 : 1);
};

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

(async () => {
  const deadline = Date.now() + Math.max(0, waitSeconds) * 1000;
  let last = null;
  for (;;) {
    const outcome = await sendOnce();
    last = outcome;
    if (outcome.kind === 'reply' && !notReadyYet(outcome.reply)) emit(outcome);
    if (outcome.kind === 'malformed') { console.error(`seat: ${outcome.message}`); process.exit(1); }
    // Everything below this line is a "not yet": the socket is not up, or the shell
    // answered that it is still starting or blocked behind a dialog.
    if (Date.now() >= deadline) break;
    const retry = last?.kind === 'reply' ? faceTablePendingReceipt(last.reply) : null;
    await sleep(retry?.retryAfterMs ?? RETRY_DELAY_MS);
  }
  if (last?.kind === 'reply') emit(last);
  console.error(`seat: ${last?.message ?? 'no reply'}${waitSeconds > 0 ? ` (waited ${waitSeconds}s)` : ''}`);
  process.exit(1);
})();
