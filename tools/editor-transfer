#!/usr/bin/env bash
# Package the portable cart/editor working set into one archive, or restore it.
#
#   tools/editor-transfer pack [archive.tar.gz|smb]
#   tools/editor-transfer unpack [archive.tar.gz|smb] [repo-directory]
#
# `smb` names the MacBook home share at smb://mbp.local/josiahprice.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ARCHIVE_NAME="reactjit-editor-transfer.tar.gz"
MANIFEST_NAME=".reactjit-transfer.sha256"
DEFAULT_ARCHIVE="$(dirname "$ROOT")/$ARCHIVE_NAME"
SMB_URL="${EDITOR_TRANSFER_SMB_URL:-smb://mbp.local/josiahprice}"
SMB_MOUNT_ROOT="${EDITOR_TRANSFER_SMB_ROOT:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gvfs/smb-share:server=mbp.local,share=josiahprice}"

STAGE_DIR=""
TEMP_ARCHIVE=""
SHA256_TOOL=()
MANIFEST_FILE_COUNT=0

cleanup() {
  if [[ -n "$STAGE_DIR" && -d "$STAGE_DIR" ]]; then
    rm -rf -- "$STAGE_DIR"
  fi
  if [[ -n "$TEMP_ARCHIVE" && -f "$TEMP_ARCHIVE" ]]; then
    rm -f -- "$TEMP_ARCHIVE"
  fi
}
trap cleanup EXIT

die() {
  printf 'editor-transfer: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  tools/editor-transfer pack [archive.tar.gz|smb]
  tools/editor-transfer unpack [archive.tar.gz|smb] [repo-directory]

Examples:
  tools/editor-transfer pack smb
  tools/editor-transfer unpack
  tools/editor-transfer pack /media/$USER/USB/reactjit-editor-transfer.tar.gz
  tools/editor-transfer unpack /Volumes/USB/reactjit-editor-transfer.tar.gz
EOF
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

mount_smb_share() {
  if [[ -d "$SMB_MOUNT_ROOT" ]]; then
    return
  fi

  need_command gio
  printf 'Mounting %s ...\n' "$SMB_URL" >&2
  gio mount "$SMB_URL" >&2
  [[ -d "$SMB_MOUNT_ROOT" ]] || die "SMB share mounted, but $SMB_MOUNT_ROOT was not found"
}

archive_path() {
  local requested="${1:-}"

  if [[ -z "$requested" ]]; then
    printf '%s\n' "$DEFAULT_ARCHIVE"
    return
  fi

  if [[ "$requested" == "smb" ]]; then
    mount_smb_share
    printf '%s/%s\n' "$SMB_MOUNT_ROOT" "$ARCHIVE_NAME"
    return
  fi

  if [[ "$requested" == /* ]]; then
    printf '%s\n' "$requested"
  else
    printf '%s/%s\n' "$PWD" "$requested"
  fi
}

# These rules keep portable source and editor-owned data while leaving each
# machine's Git database, caches, dependencies, and platform binaries alone.
TRANSFER_RULES=(
  "--filter=+ /zig-out/"
  "--filter=+ /zig-out/game/"
  "--filter=+ /zig-out/game/editor/***"
  "--filter=+ /zig-out/game/contentstore/***"
  "--filter=- /zig-out/***"
  "--exclude=/.git/"
  "--exclude=/.zig-cache/"
  "--exclude=/.cache/"
  "--exclude=/.rjit-sync-backup/"
  "--exclude=node_modules/"
  "--exclude=/$MANIFEST_NAME"
  "--exclude=/deps/"
  "--exclude=/archive/"
  "--exclude=/love2d/"
  "--exclude=/tsz/"
  "--exclude=/os/"
  "--exclude=/images/"
  "--exclude=/shots/"
  "--exclude=/pics/"
  "--exclude=/recovered-models/"
  "--exclude=/tmp/"
  "--exclude=/_MODEL_RECOVERY_BACKUP_20260629/"
  "--exclude=/cart/hmsc-int/"
  "--exclude=/bundle*.js"
  "--exclude=/bundle*.json"
  "--exclude=/tools/esbuild"
  "--exclude=/tools/v8cli"
  "--exclude=/tools/zig/"
  "--exclude=.DS_Store"
)

select_sha256_tool() {
  if (( ${#SHA256_TOOL[@]} > 0 )); then
    return
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    SHA256_TOOL=(sha256sum)
  elif command -v shasum >/dev/null 2>&1; then
    SHA256_TOOL=(shasum -a 256)
  else
    die "SHA-256 verification requires sha256sum or shasum"
  fi
}

validate_hashable_paths() {
  local root="$1" path

  while IFS= read -r -d '' path; do
    case "$path" in
      *$'\n'*|*$'\r'*|*\\*)
        die "cannot safely record a checksum for path: $path"
        ;;
    esac
  done < <(find "$root" -type f -print0)
}

validate_sha256_manifest() {
  local manifest="$1" line hash marker path
  local count=0

  [[ -f "$manifest" ]] || die "archive is missing its SHA-256 manifest"
  while IFS= read -r line || [[ -n "$line" ]]; do
    hash="${line:0:64}"
    marker="${line:64:2}"
    path="${line:66}"

    [[ ${#hash} -eq 64 && "$hash" != *[!0123456789abcdefABCDEF]* ]] \
      || die "archive contains a malformed SHA-256 digest"
    [[ "$marker" == "  " || "$marker" == " *" ]] \
      || die "archive contains a malformed SHA-256 record"
    case "$path" in
      ./*) ;;
      *) die "SHA-256 manifest contains an unsafe path: $path" ;;
    esac
    case "/${path#./}/" in
      */../*) die "SHA-256 manifest contains an unsafe path: $path" ;;
    esac
    [[ "$path" != "./$MANIFEST_NAME" ]] \
      || die "SHA-256 manifest cannot checksum itself"
    count=$((count + 1))
  done < "$manifest"

  (( count > 0 )) || die "archive contains an empty SHA-256 manifest"
  MANIFEST_FILE_COUNT="$count"
}

write_sha256_manifest() {
  local root="$1" manifest="$1/$MANIFEST_NAME"

  select_sha256_tool
  validate_hashable_paths "$root"
  (
    cd "$root"
    find . -type f ! -path "./$MANIFEST_NAME" \
      -exec "${SHA256_TOOL[@]}" {} +
  ) > "$manifest"
  validate_sha256_manifest "$manifest"
}

verify_restored_layout() {
  local source="$1" destination="$2" differences

  differences="$(rsync -rlptn --delete --itemize-changes \
    "${TRANSFER_RULES[@]}" "$source/" "$destination/")"
  if [[ -n "$differences" ]]; then
    printf 'Files still differ after restore:\n%s\n' "$differences" | sed -n '1,24p' >&2
    return 1
  fi
}

verify_sha256_manifest() {
  local root="$1" manifest="$2"

  select_sha256_tool
  validate_sha256_manifest "$manifest"
  printf 'Verifying %s transferred files with SHA-256 ...\n' "$MANIFEST_FILE_COUNT"
  (
    cd "$root"
    "${SHA256_TOOL[@]}" --quiet --strict -c "$manifest"
  )
}

pack_archive() {
  local archive parent size
  archive="$(archive_path "${1:-}")"
  parent="$(dirname "$archive")"

  need_command rsync
  need_command tar
  mkdir -p -- "$parent"
  STAGE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/reactjit-editor-transfer.XXXXXX")"
  mkdir -p -- "$STAGE_DIR/reactjit"
  TEMP_ARCHIVE="$(mktemp "$parent/.reactjit-editor-transfer.XXXXXX")"

  printf 'Collecting editor source, models, assets, maps, and game data ...\n'
  rsync -rlpt "${TRANSFER_RULES[@]}" "$ROOT/" "$STAGE_DIR/reactjit/"

  printf 'Recording SHA-256 hashes for every transferred file ...\n'
  write_sha256_manifest "$STAGE_DIR/reactjit"

  printf 'Compressing one portable archive ...\n'
  tar -czf "$TEMP_ARCHIVE" -C "$STAGE_DIR" reactjit
  tar -tzf "$TEMP_ARCHIVE" >/dev/null
  mv -f -- "$TEMP_ARCHIVE" "$archive"
  TEMP_ARCHIVE=""

  size="$(du -h "$archive" | awk '{print $1}')"
  printf 'Ready: %s (%s, %s files hashed)\n' "$archive" "$size" "$MANIFEST_FILE_COUNT"
}

validate_archive_entries() {
  local archive="$1" entry

  while IFS= read -r entry; do
    case "$entry" in
      reactjit|reactjit/*) ;;
      *) die "archive contains an unexpected path: $entry" ;;
    esac
    case "/$entry/" in
      */../*) die "archive contains an unsafe path: $entry" ;;
    esac
  done < <(tar -tzf "$archive")
}

unpack_archive() {
  local archive destination backup manifest stamp
  archive="$(archive_path "${1:-}")"
  destination="${2:-$ROOT}"

  if [[ "$destination" != /* ]]; then
    destination="$PWD/$destination"
  fi

  need_command rsync
  need_command tar
  [[ -f "$archive" ]] || die "archive not found: $archive"
  validate_archive_entries "$archive"

  STAGE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/reactjit-editor-transfer.XXXXXX")"
  printf 'Unpacking %s ...\n' "$archive"
  tar -xzf "$archive" -C "$STAGE_DIR"
  [[ -d "$STAGE_DIR/reactjit/cart/editor" ]] || die "archive is missing cart/editor"
  manifest="$STAGE_DIR/reactjit/$MANIFEST_NAME"
  validate_sha256_manifest "$manifest"

  mkdir -p -- "$destination"
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup="$destination/.rjit-sync-backup/$stamp"
  mkdir -p -- "$backup"

  rsync -rlpt --delete --backup --backup-dir="$backup" \
    "${TRANSFER_RULES[@]}" "$STAGE_DIR/reactjit/" "$destination/"

  printf 'Rollback copy for replaced files: %s\n' "$backup"
  verify_restored_layout "$STAGE_DIR/reactjit" "$destination" \
    || die "post-unpack layout verification failed"
  verify_sha256_manifest "$destination" "$manifest" \
    || die "post-unpack SHA-256 verification failed"

  printf 'Restored: %s\n' "$destination"
  printf 'Integrity verified: all %s transferred files match.\n' "$MANIFEST_FILE_COUNT"
}

case "${1:-}" in
  pack)
    pack_archive "${2:-}"
    ;;
  unpack)
    unpack_archive "${2:-}" "${3:-}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
